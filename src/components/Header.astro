---
import { SITE_NAME } from '../lib/config';
import AuthWidget from './AuthWidget.tsx';
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="返回首页">
      <span class="brand__mark" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M9 18V5.5c0-.6.5-1 1.1-1l8.4 1.6c.5.1.9.6.9 1.1V16a2 2 0 1 1-2-2V8.3l-6.4-1.2V18a2 2 0 1 1-2-2V18Zm-2-2a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z" />
        </svg>
      </span>
      <span>
        {SITE_NAME}
        <span class="brand__sub">World Music Radio</span>
      </span>
    </a>
    <nav class="site-nav" aria-label="主导航">
      <a href="/">首页</a>
      <a href="/#regions">大洲巡礼</a>
      <a href="/message-board">留言板</a>
      <AuthWidget client:load />
    </nav>
  </div>
</header>
