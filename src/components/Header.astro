---
import { SITE_NAME } from '../lib/config';
import { t0 } from '../lib/i18n';
import AuthWidget from './AuthWidget.tsx';
import LanguageSwitcher from './LanguageSwitcher.tsx';
import MarieReplayButton from './MarieReplayButton.tsx';

// 当前路径：用于导航项的「正在收听这个频段」状态
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHome = path === '/';
const isExplore = path === '/explore' || path.startsWith('/countries/');
const isBoard = path === '/message-board';
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label={t0.navHome}>
      <span class="brand__mark" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M9 18V5.5c0-.6.5-1 1.1-1l8.4 1.6c.5.1.9.6.9 1.1V16a2 2 0 1 1-2-2V8.3l-6.4-1.2V18a2 2 0 1 1-2-2V18Zm-2-2a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z" />
        </svg>
      </span>
      <span>
        {SITE_NAME}
        <span class="brand__sub">World Music Radio</span>
      </span>
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      <a href="/" class:list={[{ 'is-active': isHome }]} aria-current={isHome ? 'page' : undefined} data-i18n="navHome">{t0.navHome}</a>
      <a href="/explore" class:list={[{ 'is-active': isExplore }]} aria-current={isExplore ? 'page' : undefined} data-i18n="navExplore">{t0.navExplore}</a>
      <a href="/message-board" class:list={[{ 'is-active': isBoard }]} aria-current={isBoard ? 'page' : undefined} data-i18n="navGuestbook">{t0.navGuestbook}</a>
      <LanguageSwitcher client:load />
      <MarieReplayButton client:load />
      <AuthWidget client:load />
    </nav>
  </div>
</header>
