---
import { SITE_NAME, SITE_SLOGAN } from '../lib/config';
import { t0 } from '../lib/i18n';
import { allCountries } from '../data';
import radiosData from '../data/radios.json';
import VisitorCounter from './VisitorCounter.tsx';

// 统计页面上实际可在线收听的音乐电台总数：
// = 各国精选可播放电台（notableRadios 带 url）+ 自动采集的在线流（radios.json，notable-only 国家不叠加）
const radios = radiosData as Record<string, any[]>;
const totalRadios = allCountries.reduce((sum, c) => {
  const notable = (c.notableRadios || []).filter((r) => r.url).length;
  const fetched = c.radioMode === 'notable-only' ? 0 : (radios[c.iso] || []).length;
  return sum + notable + fetched;
}, 0);
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div>
        <div class="site-footer__brand">{SITE_NAME}</div>
        <p style="color: var(--ink-soft);" data-i18n="subtitle">{t0.subtitle}</p>
        <p style="color: var(--ink-faint); font-size: 0.82rem;">
          <span data-i18n="footerIncluded">{t0.footerIncluded}</span> <b>{allCountries.length}</b> <span data-i18n="footerStats">{t0.footerStats}</span> <b>{totalRadios}</b> <span data-i18n="footerStats2">{t0.footerStats2}</span>
        </p>
      </div>
      <div>
        <h4 data-i18n="footerExplore">{t0.footerExplore}</h4>
        <ul>
          <li><a href="/#regions" data-i18n="footerBrowse">{t0.footerBrowse}</a></li>
          <li><a href="/message-board" data-i18n="navGuestbook">{t0.navGuestbook}</a></li>
        </ul>
      </div>
      <div>
        <details class="footer-about">
          <summary data-i18n="footerAbout">{t0.footerAbout}</summary>
          <p class="footer-about__line" data-i18n="footerAboutLine">{t0.footerAboutLine}</p>
        </details>
        <ul>
          <li><a href="/#regions" data-i18n="footerIndex">{t0.footerIndex}</a></li>
          <li><a href="/" data-i18n="footerHome">{t0.footerHome}</a></li>
        </ul>
      </div>
    </div>
    <div class="site-footer__fine">
      <span>© {new Date().getFullYear()} {SITE_NAME} · {SITE_SLOGAN}</span>
      <span data-i18n="footerRadioNote">{t0.footerRadioNote}</span>
      <VisitorCounter client:load />
    </div>
  </div>
</footer>
