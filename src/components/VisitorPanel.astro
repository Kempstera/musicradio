---
// 访客足迹面板 —— 页面最底部，默认折叠成一条窄条
//
// 设计原则：
//   1. 不破坏现有布局：收起时只有一个 <summary> 高度，展开才占空间
//   2. 懒加载：只有第一次展开才请求 /api/visitors，不拖慢首屏
//   3. 数据全部来自脱敏视图：IP 只显示到网段，绝不展示原始地址
---

<section class="vp" id="vp-root" data-loaded="0">
  <div class="vp__inner">
    <details class="vp__details">
      <summary class="vp__summary">
        <span class="vp__pulse" aria-hidden="true"></span>
        <span class="vp__label" data-vp="title">访客足迹</span>
        <span class="vp__hint" data-vp="hint">看看谁从远方来过</span>
        <span class="vp__count" id="vp-count"></span>
        <span class="vp__chev" aria-hidden="true">＋</span>
      </summary>

      <div class="vp__body">
        <div class="vp__kpis" id="vp-kpis"></div>

        <div class="vp__cols">
          <div class="vp__block">
            <h5 data-vp="sources">来源</h5>
            <ul class="vp__bars" id="vp-sources"></ul>
          </div>
          <div class="vp__block">
            <h5 data-vp="geo">地区</h5>
            <ul class="vp__bars" id="vp-geo"></ul>
          </div>
          <div class="vp__block">
            <h5 data-vp="pages">热门页面</h5>
            <ul class="vp__bars" id="vp-pages"></ul>
          </div>
          <div class="vp__block">
            <h5 data-vp="clicks">点击与播放</h5>
            <ul class="vp__bars" id="vp-clicks"></ul>
          </div>
        </div>

        <div class="vp__block vp__block--wide">
          <h5 data-vp="recent">最近访问</h5>
          <div class="vp__feed" id="vp-feed"></div>
        </div>

        <p class="vp__note" data-vp="note">
          IP 已脱敏，仅统计访问行为；不记录任何输入内容，也不使用广告 Cookie。
        </p>
      </div>
    </details>
  </div>
</section>

<style is:global>
  .vp {
    background: var(--paper-2);
    border-top: 1px solid var(--line-soft);
    font-family: var(--font-body);
    color: var(--ink-soft);
  }
  .vp__inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .vp__details > summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 0;
    font-size: 0.82rem;
    color: var(--ink-soft);
    user-select: none;
  }
  .vp__details > summary::-webkit-details-marker { display: none; }
  .vp__details > summary:hover { color: var(--ink); }

  .vp__pulse {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--verde);
    box-shadow: 0 0 0 0 rgba(53, 96, 79, 0.5);
    animation: vp-pulse 2.4s ease-out infinite;
    flex: none;
  }
  @keyframes vp-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(53, 96, 79, 0.45); }
    70%  { box-shadow: 0 0 0 7px rgba(53, 96, 79, 0); }
    100% { box-shadow: 0 0 0 0 rgba(53, 96, 79, 0); }
  }
  .vp__label { font-weight: 600; letter-spacing: 0.02em; color: var(--ink); }
  .vp__hint {
    color: var(--ink-faint);
    font-size: 0.76rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .vp__count {
    margin-left: auto;
    color: var(--gold-deep);
    font-variant-numeric: tabular-nums;
    font-size: 0.78rem;
    white-space: nowrap;
  }
  .vp__chev {
    flex: none;
    color: var(--ink-faint);
    font-size: 0.9rem;
    transition: transform 0.2s ease;
  }
  .vp__details[open] .vp__chev { transform: rotate(45deg); }

  .vp__body { padding: 0.2rem 0 1.8rem; }

  .vp__kpis {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.7rem;
    margin-bottom: 1.4rem;
  }
  .vp__kpi {
    background: var(--surface);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-sm);
    padding: 0.7rem 0.85rem;
  }
  .vp__kpi b {
    display: block;
    font-family: var(--font-display);
    font-size: 1.32rem;
    line-height: 1.15;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .vp__kpi b small { font-size: 0.7rem; font-weight: 400; color: var(--ink-faint); margin-left: 2px; }
  .vp__kpi span { font-size: 0.7rem; color: var(--ink-faint); }

  .vp__cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
    margin-bottom: 1.2rem;
  }
  .vp__block {
    background: var(--surface);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-sm);
    padding: 0.85rem 0.95rem;
  }
  .vp__block h5 {
    margin: 0 0 0.55rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .vp__bars { list-style: none; margin: 0; padding: 0; }
  .vp__bars li {
    display: grid;
    grid-template-columns: 1fr 42px;
    grid-template-areas: 'name num' 'bar bar';
    gap: 2px 6px;
    padding: 0.24rem 0;
    font-size: 0.76rem;
  }
  .vp__bars .n {
    grid-area: name;
    color: var(--ink-soft);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .vp__bars .c {
    grid-area: num;
    text-align: right;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }
  .vp__bars .b {
    grid-area: bar;
    height: 3px;
    background: var(--line-soft);
    border-radius: 2px;
    overflow: hidden;
  }
  .vp__bars .b i {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--gold), var(--gold-pale));
    border-radius: 2px;
  }
  .vp__empty { color: var(--ink-faint); font-size: 0.75rem; padding: 0.3rem 0; }

  .vp__feed {
    display: grid;
    gap: 1px;
    background: var(--line-soft);
    border-radius: 6px;
    overflow: hidden;
    font-size: 0.76rem;
  }
  .vp__row {
    display: grid;
    grid-template-columns: 84px 1fr 1fr 92px 78px;
    gap: 0.5rem;
    background: var(--surface);
    padding: 0.5rem 0.65rem;
    align-items: center;
  }
  .vp__row--head {
    background: var(--surface-deep);
    color: var(--ink-faint);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .vp__row > span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .vp__row .t { color: var(--ink-faint); font-variant-numeric: tabular-nums; }
  .vp__row .g { color: var(--ink); }
  .vp__row .s { color: var(--ink-soft); }
  .vp__row .st { color: var(--verde); font-variant-numeric: tabular-nums; }
  .vp__row .d { color: var(--ink-faint); text-align: right; }

  .vp__note {
    margin: 0.9rem 0 0;
    font-size: 0.7rem;
    color: var(--ink-faint);
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .vp__kpis { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .vp__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .vp__row { grid-template-columns: 68px 1fr 82px; }
    .vp__row .s, .vp__row .d { display: none; }
  }
  @media (max-width: 560px) {
    .vp__hint { display: none; }
    .vp__kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .vp__cols { grid-template-columns: 1fr; }
    .vp__row { grid-template-columns: 62px 1fr 66px; font-size: 0.72rem; }
    .vp__row .s, .vp__row .d { display: none; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('vp-root');
    if (!root) return;
    var details = root.querySelector('.vp__details');

    var I18N = {
      zh: {
        title: '访客足迹',
        hint: '看看谁从远方来过',
        sources: '来源',
        geo: '地区',
        pages: '热门页面',
        clicks: '点击与播放',
        recent: '最近访问',
        note: 'IP 已脱敏，仅统计访问行为；不记录任何输入内容，也不使用广告 Cookie。',
        today: '今日访客',
        week: '近七日',
        total: '累计访客',
        sessions: '累计访问',
        avgStay: '平均停留',
        colTime: '时间',
        colWhere: '来自',
        colSource: '来源',
        colStay: '停留',
        colDev: '设备',
        unknown: '未知',
        direct: '直接访问',
        internal: '站内跳转',
        empty: '暂无数据',
        people: '位',
        times: '次',
      },
      en: {
        title: 'Visitor trail',
        hint: 'See who stopped by from afar',
        sources: 'Sources',
        geo: 'Locations',
        pages: 'Top pages',
        clicks: 'Clicks & plays',
        recent: 'Recent visits',
        note: 'IPs are masked. Behaviour only — no input content is recorded, no ad cookies.',
        today: 'Today',
        week: 'Last 7 days',
        total: 'Visitors',
        sessions: 'Sessions',
        avgStay: 'Avg. stay',
        colTime: 'Time',
        colWhere: 'From',
        colSource: 'Source',
        colStay: 'Stay',
        colDev: 'Device',
        unknown: 'Unknown',
        direct: 'Direct',
        internal: 'Internal',
        empty: 'No data yet',
        people: '',
        times: '',
      },
    };

    function dict() {
      var l = 'en';
      try {
        l = localStorage.getItem('mr_lang') || document.documentElement.lang || 'en';
      } catch (e) {
        l = document.documentElement.lang || 'en';
      }
      return l.indexOf('zh') === 0 ? I18N.zh : I18N.en;
    }

    function applyLang() {
      var d = dict();
      root.querySelectorAll('[data-vp]').forEach(function (el) {
        var k = el.getAttribute('data-vp');
        if (d[k]) el.textContent = d[k];
      });
      root.setAttribute('data-lang', d === I18N.zh ? 'zh' : 'en');
    }

    // 站点语言切换时同步（i18n 广播 mr:lang-changed）
    window.addEventListener('mr:lang-changed', function () {
      applyLang();
      if (root.getAttribute('data-loaded') === '1') render();
    });

    function flag(cc) {
      if (!cc || cc.length !== 2) return '🌐';
      try {
        return String.fromCodePoint.apply(
          null,
          cc.toUpperCase().split('').map(function (c) {
            return 0x1f1e6 - 65 + c.charCodeAt(0);
          })
        );
      } catch (e) {
        return '🌐';
      }
    }

    function dur(ms) {
      if (!ms || ms < 1000) return '—';
      var s = Math.round(ms / 1000);
      if (s < 60) return s + 's';
      var m = Math.floor(s / 60);
      if (m < 60) return m + 'm ' + (s % 60) + 's';
      return Math.floor(m / 60) + 'h ' + (m % 60) + 'm';
    }

    function time(iso) {
      try {
        var t = new Date(iso);
        var p = function (n) {
          return n < 10 ? '0' + n : '' + n;
        };
        return p(t.getMonth() + 1) + '-' + p(t.getDate()) + ' ' + p(t.getHours()) + ':' + p(t.getMinutes());
      } catch (e) {
        return '—';
      }
    }

    function devIcon(d) {
      if (d === 'mobile') return '📱';
      if (d === 'tablet') return '📱';
      if (d === 'bot') return '🤖';
      return '🖥';
    }

    function pretty(k, d) {
      if (k === '(direct)') return d.direct;
      if (k === '(站内)') return d.internal;
      if (!k) return d.unknown;
      return k;
    }

    function bars(el, arr, d) {
      el.textContent = '';
      if (!arr || !arr.length) {
        var p = document.createElement('li');
        p.className = 'vp__empty';
        p.textContent = d.empty;
        el.appendChild(p);
        return;
      }
      var max = 1;
      arr.forEach(function (x) {
        if (x.c > max) max = x.c;
      });
      arr.forEach(function (x) {
        var li = document.createElement('li');

        var n = document.createElement('span');
        n.className = 'n';
        n.textContent = pretty(x.k, d);
        n.title = pretty(x.k, d);

        var c = document.createElement('span');
        c.className = 'c';
        c.textContent = x.c;

        var b = document.createElement('span');
        b.className = 'b';
        var i = document.createElement('i');
        i.style.width = Math.max((x.c / max) * 100, 4) + '%';
        b.appendChild(i);

        li.appendChild(n);
        li.appendChild(c);
        li.appendChild(b);
        el.appendChild(li);
      });
    }

    function kpis(el, t, d) {
      el.textContent = '';
      var items = [
        { v: t.day_visitors != null ? t.day_visitors : t.day || 0, unit: d.people, l: d.today },
        { v: t.week || 0, unit: d.times, l: d.week },
        { v: t.visitors || 0, unit: d.people, l: d.total },
        { v: t.sessions || 0, unit: d.times, l: d.sessions },
        { v: dur((t.avg_stay_sec || 0) * 1000), unit: '', l: d.avgStay },
      ];
      items.forEach(function (it) {
        var box = document.createElement('div');
        box.className = 'vp__kpi';
        var b = document.createElement('b');
        b.textContent = it.v;
        if (it.unit) {
          var s = document.createElement('small');
          s.textContent = it.unit;
          b.appendChild(s);
        }
        var sp = document.createElement('span');
        sp.textContent = it.l;
        box.appendChild(b);
        box.appendChild(sp);
        el.appendChild(box);
      });
    }

    function feed(el, rows, d) {
      el.textContent = '';
      var head = document.createElement('div');
      head.className = 'vp__row vp__row--head';
      [d.colTime, d.colWhere, d.colSource, d.colStay, d.colDev].forEach(function (txt) {
        var s = document.createElement('span');
        s.textContent = txt;
        head.appendChild(s);
      });
      el.appendChild(head);

      if (!rows || !rows.length) {
        var e = document.createElement('div');
        e.className = 'vp__row';
        var s = document.createElement('span');
        s.textContent = d.empty;
        e.appendChild(s);
        el.appendChild(e);
        return;
      }

      rows.forEach(function (r) {
        var row = document.createElement('div');
        row.className = 'vp__row';

        var t = document.createElement('span');
        t.className = 't';
        t.textContent = time(r.started_at);

        var g = document.createElement('span');
        g.className = 'g';
        var place = r.city || r.region || r.country || d.unknown;
        g.textContent = flag(r.country_code) + ' ' + place;
        g.title = [r.country, r.region, r.city, r.ip_masked].filter(Boolean).join(' · ');

        var src = document.createElement('span');
        src.className = 's';
        src.textContent = pretty(r.ref_host, d);
        src.title = pretty(r.ref_host, d);

        var st = document.createElement('span');
        st.className = 'st';
        st.textContent = dur(r.stay_ms);

        var dv = document.createElement('span');
        dv.className = 'd';
        dv.textContent = devIcon(r.device) + ' ' + (r.browser || '');

        row.appendChild(t);
        row.appendChild(g);
        row.appendChild(src);
        row.appendChild(st);
        row.appendChild(dv);
        el.appendChild(row);
      });
    }

    var payload = null;

    function render() {
      if (!payload || !payload.stats) return;
      var d = dict();
      var s = payload.stats;
      var t = s.totals || {};

      kpis(document.getElementById('vp-kpis'), t, d);
      bars(document.getElementById('vp-sources'), s.sources, d);
      bars(document.getElementById('vp-geo'), s.geo, d);
      bars(document.getElementById('vp-pages'), s.pages, d);
      bars(document.getElementById('vp-clicks'), s.clicks, d);
      feed(document.getElementById('vp-feed'), payload.feed, d);

      var cnt = document.getElementById('vp-count');
      if (cnt && t.day_visitors != null) {
        cnt.textContent = d.title === I18N.zh.title ? '今日 ' + t.day_visitors + ' 位' : 'Today ' + t.day_visitors;
      }
    }

    function load() {
      if (root.getAttribute('data-loaded') === '1') return;
      root.setAttribute('data-loaded', '1');
      fetch('/api/visitors?limit=20')
        .then(function (r) {
          return r.json();
        })
        .then(function (json) {
          payload = json;
          render();
        })
        .catch(function () {
          root.setAttribute('data-loaded', '0');
        });
    }

    applyLang();
    details.addEventListener('toggle', function () {
      if (details.open) load();
    });
  })();
</script>
