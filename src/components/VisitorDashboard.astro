---
// 访客数据看板 —— 仅站长可见（挂在 /visits，不在任何导航里出现）
//
// 三重防护：
//   1. 页面不在 Header/Footer 里出现，访客无从发现
//   2. 页面本身 noindex，搜索引擎不收录
//   3. 真正的数据接口 /api/visitors 需要口令（Cloudflare 环境变量 VISITS_TOKEN
//      或 supabase/analytics-v2.sql 里的站长口令），口令错一律 401
//
// 两种数据模式（接口自己判断，页面只负责展示）：
//   full   —— 真实 IP、运营商 ASN、完整 UA、屏幕、会话内页面序列与播放目标
//   legacy —— 脱敏视图：IP 打码、字段较少，但不依赖 v2 迁移
//
// 页面不做任何聚合请求：一次取回明细（最多 3000 条），排行榜、趋势、洞察全部在
// 浏览器里现算 —— 这样切换时间范围、搜索、排序都不用再打接口。
---

<section class="vd">
  <div class="vd__gate" id="vd-gate">
    <div class="vd__gate-card">
      <h2>站长专用</h2>
      <p>输入口令后加载访客数据。用 <code>VISITS_TOKEN</code> 进站是脱敏模式；用 <code>analytics-v2.sql</code> 里那个口令进站，可以看到真实 IP 与完整明细。</p>
      <div class="vd__gate-row">
        <input id="vd-key" type="password" autocomplete="current-password" placeholder="访问口令" />
        <button id="vd-go">解锁</button>
      </div>
      <p class="vd__msg" id="vd-msg"></p>
    </div>
  </div>

  <div class="vd__body" id="vd-body" hidden>
    <header class="vd__head">
      <div class="vd__title">
        <h2>访客数据</h2>
        <p class="vd__sub" id="vd-meta">—</p>
      </div>
      <div class="vd__actions">
        <div class="vd__range" id="vd-range" role="group" aria-label="时间范围">
          <button data-days="1">今天</button>
          <button data-days="7">7 天</button>
          <button data-days="30" class="is-on">30 天</button>
          <button data-days="90">90 天</button>
          <button data-days="3650">全部</button>
        </div>
        <button class="vd__btn vd__btn--ghost" id="vd-refresh">刷新</button>
        <button class="vd__btn vd__btn--ghost" id="vd-csv">导出 CSV</button>
        <button class="vd__btn vd__btn--ghost" id="vd-exit">退出</button>
      </div>
    </header>

    <p class="vd__banner" id="vd-banner" hidden></p>

    <div class="vd__kpis" id="vd-kpis"></div>

    <div class="vd__grid2">
      <div class="vd__block">
        <h5>访问趋势 <span class="vd__hint">柱＝会话数，线＝访客数</span></h5>
        <div class="vd__chart" id="vd-trend"></div>
      </div>
      <div class="vd__block">
        <h5>时段分布 <span class="vd__hint">按访客本地时间</span></h5>
        <div class="vd__chart" id="vd-hours"></div>
      </div>
    </div>

    <div class="vd__insights" id="vd-insights"></div>

    <div class="vd__cols">
      <div class="vd__block"><h5>设备</h5><ul class="vd__bars" id="vd-device"></ul></div>
      <div class="vd__block"><h5>浏览器 / 入口</h5><ul class="vd__bars" id="vd-browser"></ul></div>
      <div class="vd__block"><h5>系统</h5><ul class="vd__bars" id="vd-os"></ul></div>
      <div class="vd__block"><h5>界面语言</h5><ul class="vd__bars" id="vd-lang"></ul></div>
    </div>

    <div class="vd__cols">
      <div class="vd__block"><h5>来源</h5><ul class="vd__bars" id="vd-sources"></ul></div>
      <div class="vd__block"><h5>落地页</h5><ul class="vd__bars" id="vd-pages"></ul></div>
      <div class="vd__block"><h5>播放 / 点击最多的电台</h5><ul class="vd__bars" id="vd-stations"></ul></div>
      <div class="vd__block"><h5>网络 / 接入点</h5><ul class="vd__bars" id="vd-net"></ul></div>
    </div>

    <div class="vd__cols">
      <div class="vd__block"><h5>国家 / 地区</h5><ul class="vd__bars" id="vd-country"></ul></div>
      <div class="vd__block"><h5>城市</h5><ul class="vd__bars" id="vd-city"></ul></div>
      <div class="vd__block"><h5>停留时长分布</h5><ul class="vd__bars" id="vd-duration"></ul></div>
      <div class="vd__block"><h5>滚动深度</h5><ul class="vd__bars" id="vd-scroll"></ul></div>
    </div>

    <div class="vd__block vd__block--wide">
      <div class="vd__tablehead">
        <h5>访问明细 <span class="vd__hint" id="vd-count"></span></h5>
        <div class="vd__tools">
          <input id="vd-q" type="search" placeholder="搜索 IP / 城市 / 页面 / 来源" />
          <select id="vd-size" aria-label="每页条数">
            <option value="25">25 条/页</option>
            <option value="50" selected>50 条/页</option>
            <option value="100">100 条/页</option>
            <option value="300">300 条/页</option>
          </select>
        </div>
      </div>
      <div class="vd__table" id="vd-table"></div>
      <div class="vd__pager" id="vd-pager"></div>
    </div>
  </div>
</section>

<style is:global>
  .vd { max-width: 1240px; margin: 0 auto; padding: 2.2rem var(--gutter) 4.5rem; color: var(--ink-2); }
  .vd h2 { font-family: var(--f-display); font-size: 1.5rem; color: var(--ink); margin: 0 0 0.3rem; }
  .vd__sub { font-size: 0.78rem; color: var(--ink-3); margin: 0; }
  .vd__hint { font-size: 0.66rem; font-weight: 400; letter-spacing: 0.02em; text-transform: none; color: var(--ink-3); margin-left: 0.35rem; }
  .vd code { font-family: var(--f-mono); font-size: 0.92em; background: var(--sunken); padding: 0.05em 0.3em; border-radius: 3px; }

  .vd__gate { display: flex; justify-content: center; padding: 6vh 0 10vh; }
  .vd__gate[hidden], .vd__body[hidden] { display: none !important; }
  .vd__gate-card {
    background: var(--sheet); border: 1px solid var(--rule-2); border-radius: var(--radius);
    padding: 2rem 2rem 1.6rem; max-width: 460px; width: 100%; box-shadow: var(--shadow-sm);
  }
  .vd__gate-card p { font-size: 0.86rem; color: var(--ink-3); margin: 0.5rem 0 1.1rem; line-height: 1.75; }
  .vd__gate-row { display: flex; gap: 0.5rem; }
  .vd__gate-row input {
    flex: 1; min-width: 0; padding: 0.62rem 0.8rem; font-size: 16px; font-family: var(--f-mono);
    background: var(--sheet); border: 1px solid var(--rule); border-radius: var(--radius-sm); color: var(--ink);
  }
  .vd__gate-row input:focus { outline: 2px solid var(--ai-line); border-color: var(--ai); }
  .vd__gate-row button, .vd__btn {
    background: var(--ai); color: #fff; font-weight: 600; border: none; border-radius: var(--radius-sm);
    padding: 0.62rem 1.15rem; font-size: 0.84rem; font-family: var(--f-body); cursor: pointer;
  }
  .vd__gate-row button:hover { background: var(--ai-deep); }
  .vd__btn--ghost { background: transparent; color: var(--ink-2); border: 1px solid var(--rule); }
  .vd__btn--ghost:hover { background: var(--ai-soft); color: var(--ink); border-color: var(--ai-line); }
  .vd__msg { font-size: 0.78rem !important; color: var(--shu) !important; margin: 0.8rem 0 0 !important; min-height: 1.1em; }
  .vd__msg.ok { color: var(--matsu) !important; }

  .vd__head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.1rem; flex-wrap: wrap; }
  .vd__actions { display: flex; gap: 0.45rem; align-items: center; flex-wrap: wrap; }
  .vd__range { display: inline-flex; border: 1px solid var(--rule); border-radius: var(--radius-sm); overflow: hidden; }
  .vd__range button {
    border: 0; background: transparent; color: var(--ink-3); cursor: pointer;
    font-family: var(--f-body); font-size: 0.78rem; padding: 0.48rem 0.7rem; min-height: 38px;
  }
  .vd__range button + button { border-left: 1px solid var(--rule-2); }
  .vd__range button.is-on { background: var(--ai); color: #fff; }

  .vd__banner {
    margin: 0 0 1rem; padding: 0.7rem 0.9rem; font-size: 0.8rem; line-height: 1.7;
    background: rgba(177, 80, 58, 0.06); border: 1px solid rgba(177, 80, 58, 0.18);
    border-left: 3px solid var(--shu); border-radius: var(--radius-sm); color: var(--ink-2);
  }

  .vd__kpis { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0.6rem; margin-bottom: 0.8rem; }
  .vd__kpi { background: var(--sheet); border: 1px solid var(--rule-2); border-radius: var(--radius-sm); padding: 0.8rem 0.85rem; }
  .vd__kpi b { display: block; font-family: var(--f-display); font-size: 1.42rem; color: var(--ink); font-variant-numeric: tabular-nums; line-height: 1.15; }
  .vd__kpi b small { font-size: 0.68rem; font-weight: 400; color: var(--ink-3); margin-left: 2px; }
  .vd__kpi span { font-size: 0.7rem; color: var(--ink-3); }
  .vd__kpi i { display: block; font-style: normal; font-size: 0.68rem; margin-top: 0.2rem; color: var(--ink-3); }
  .vd__kpi i.up { color: var(--shu); }
  .vd__kpi i.down { color: var(--matsu); }

  .vd__grid2 { display: grid; grid-template-columns: 1.55fr 1fr; gap: 0.6rem; margin-bottom: 0.8rem; }
  .vd__cols { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.6rem; margin-bottom: 0.8rem; }
  .vd__block { background: var(--sheet); border: 1px solid var(--rule-2); border-radius: var(--radius-sm); padding: 0.85rem 0.95rem; }
  .vd__block--wide { margin-bottom: 0.8rem; }
  .vd__block h5 {
    margin: 0 0 0.6rem; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--ink-3);
  }
  .vd__chart { width: 100%; overflow: hidden; }
  .vd__chart svg { display: block; width: 100%; height: auto; }

  .vd__insights { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; margin-bottom: 0.8rem; }
  .vd__insight {
    display: flex; gap: 0.65rem; background: var(--sheet); border: 1px solid var(--rule-2);
    border-left: 3px solid var(--ai); border-radius: var(--radius-sm); padding: 0.75rem 0.9rem;
  }
  .vd__insight--warn { border-left-color: var(--shu); }
  .vd__insight--good { border-left-color: var(--matsu); }
  .vd__insight b { display: block; font-size: 0.82rem; color: var(--ink); margin-bottom: 0.15rem; font-weight: 600; }
  .vd__insight p { margin: 0; font-size: 0.78rem; line-height: 1.7; color: var(--ink-2); }
  .vd__insight span.ico { font-size: 0.95rem; line-height: 1.35; }

  .vd__bars { list-style: none; margin: 0; padding: 0; }
  .vd__bars li {
    display: grid; grid-template-columns: 1fr 46px; grid-template-areas: 'name num' 'bar bar';
    gap: 2px 6px; padding: 0.24rem 0;
  }
  .vd__bars .n { grid-area: name; font-size: 0.76rem; color: var(--ink-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .vd__bars .c { grid-area: num; text-align: right; color: var(--ink-3); font-size: 0.74rem; font-variant-numeric: tabular-nums; }
  .vd__bars .b { grid-area: bar; height: 3px; background: var(--rule-2); border-radius: 2px; overflow: hidden; }
  .vd__bars .b i { display: block; height: 100%; background: var(--ai); opacity: 0.55; border-radius: 2px; }
  .vd__empty { color: var(--ink-3); font-size: 0.76rem; padding: 0.3rem 0; }

  .vd__tablehead { display: flex; justify-content: space-between; align-items: flex-end; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
  .vd__tablehead h5 { margin: 0; }
  .vd__tools { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .vd__tools input, .vd__tools select {
    font-family: var(--f-body); font-size: 16px; padding: 0.42rem 0.6rem; color: var(--ink);
    background: var(--sheet); border: 1px solid var(--rule); border-radius: var(--radius-sm); min-height: 40px;
  }
  .vd__tools input { min-width: 12rem; }
  @media (min-width: 761px) { .vd__tools input { font-size: 0.82rem; min-height: 34px; } .vd__tools select { font-size: 0.78rem; min-height: 34px; } }

  .vd__table { border: 1px solid var(--rule-2); border-radius: var(--radius-sm); overflow-x: auto; }
  .vd__row {
    display: grid;
    grid-template-columns: 92px 122px 134px 152px 112px 1fr 80px 58px;
    gap: 0.5rem; align-items: center;
    padding: 0.5rem 0.7rem; font-size: 0.76rem; border-bottom: 1px solid var(--rule-3);
    min-width: 900px; background: var(--sheet);
  }
  .vd__row:last-child { border-bottom: 0; }
  .vd__row--head {
    background: var(--sunken); color: var(--ink-3); font-size: 0.66rem; letter-spacing: 0.06em;
    text-transform: uppercase; position: sticky; top: 0; z-index: 1; cursor: pointer; user-select: none;
  }
  .vd__row > span, .vd__row > button { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .vd__row .t { color: var(--ink-3); font-variant-numeric: tabular-nums; font-family: var(--f-mono); font-size: 0.7rem; }
  .vd__row .g { color: var(--ink); }
  .vd__row .ip { font-family: var(--f-mono); font-size: 0.72rem; color: var(--ink-2); cursor: copy; border: 0; background: none; text-align: left; padding: 0; }
  .vd__row .ip:hover { color: var(--ai); text-decoration: underline; }
  .vd__row .s { color: var(--ink-2); }
  .vd__row .st { color: var(--matsu); font-variant-numeric: tabular-nums; }
  .vd__row .d { color: var(--ink-3); font-size: 0.72rem; }
  .vd__row .n2 { color: var(--ink-3); text-align: right; font-variant-numeric: tabular-nums; }

  .vd__pager { display: flex; align-items: center; gap: 0.5rem; margin-top: 0.6rem; flex-wrap: wrap; font-size: 0.78rem; color: var(--ink-3); }
  .vd__pager button {
    border: 1px solid var(--rule); background: transparent; color: var(--ink-2); cursor: pointer;
    border-radius: var(--radius-sm); padding: 0.38rem 0.7rem; font-family: var(--f-body); font-size: 0.78rem; min-height: 36px;
  }
  .vd__pager button:disabled { opacity: 0.4; cursor: default; }

  @media (max-width: 1100px) {
    .vd__kpis { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .vd__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .vd__grid2 { grid-template-columns: 1fr; }
    .vd__insights { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .vd { padding-top: 1.4rem; }
    .vd__kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .vd__cols { grid-template-columns: 1fr; }
    .vd__actions { width: 100%; }
    .vd__range { flex: 1 1 auto; }
    .vd__range button { flex: 1; padding: 0.45rem 0.3rem; }
    .vd__head h2 { font-size: 1.28rem; }
  }
</style>

<script>
  (function () {
    var gate = document.getElementById('vd-gate');
    var body = document.getElementById('vd-body');
    var msg = document.getElementById('vd-msg');
    var input = document.getElementById('vd-key');
    var KEY_STORE = 'mr_visits_key';
    var DAYS_STORE = 'mr_visits_days';
    var MAX_ROWS = 3000;

    var state = {
      key: '',
      days: 30,
      mode: '',
      rows: [],
      total: 0,
      page: 1,
      size: 50,
      q: '',
      sort: 'time',
      dir: -1,
    };

    /* ---------------- 小工具 ---------------- */
    function el(id) { return document.getElementById(id); }
    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }
    function pad(n) { return n < 10 ? '0' + n : '' + n; }
    function fmtTime(iso) {
      if (!iso) return '—';
      var t = new Date(iso);
      if (isNaN(t)) return '—';
      return pad(t.getMonth() + 1) + '-' + pad(t.getDate()) + ' ' + pad(t.getHours()) + ':' + pad(t.getMinutes());
    }
    function fmtDay(d) { return pad(d.getMonth() + 1) + '-' + pad(d.getDate()); }
    function fmtDur(ms) {
      if (!ms || ms < 1000) return '—';
      var s = Math.round(ms / 1000);
      if (s < 60) return s + ' 秒';
      var m = Math.floor(s / 60);
      if (m < 60) return m + ' 分' + (s % 60 ? ' ' + (s % 60) + ' 秒' : '');
      return Math.floor(m / 60) + ' 时 ' + (m % 60) + ' 分';
    }
    function flag(cc) {
      if (!cc || cc.length !== 2) return '🌐';
      try {
        return String.fromCodePoint.apply(null, cc.toUpperCase().split('').map(function (c) {
          return 0x1f1e6 - 65 + c.charCodeAt(0);
        }));
      } catch (e) { return '🌐'; }
    }
    function devIcon(d) { return d === 'mobile' ? '📱' : d === 'tablet' ? '📲' : d === 'bot' ? '🤖' : '🖥'; }
    function pretty(k) {
      if (k === '(direct)') return '直接打开 / 微信内点开';
      if (k === '(站内)') return '站内跳转';
      return k || '未知';
    }
    function pct(a, b) { return b ? Math.round((a / b) * 100) : 0; }
    function sum(arr) { return arr.reduce(function (a, b) { return a + b; }, 0); }

    /* 通用计数排序：返回 [{k,c}]，剔除空值 */
    function countBy(rows, fn) {
      var m = {};
      rows.forEach(function (r) {
        var k = fn(r);
        if (k === null || k === undefined || k === '') return;
        m[k] = (m[k] || 0) + 1;
      });
      return Object.keys(m).map(function (k) { return { k: k, c: m[k] }; }).sort(function (a, b) { return b.c - a.c; });
    }

    function ipOf(r) { return r.ip || r.ip_masked || ''; }
    function stays(r) { return Number(r.stay_ms) || 0; }

    /* ---------------- 渲染：条状榜 ---------------- */
    function bars(id, arr, limit, labelFn) {
      var host = el(id);
      if (!host) return;
      host.innerHTML = '';
      if (!arr || !arr.length) {
        host.innerHTML = '<li class="vd__empty">暂无数据</li>';
        return;
      }
      var list = arr.slice(0, limit || 8);
      var max = Math.max.apply(null, list.map(function (x) { return x.c; })) || 1;
      var html = list.map(function (x) {
        var name = labelFn ? labelFn(x) : pretty(x.k);
        return '<li><span class="n" title="' + esc(name) + '">' + esc(name) + '</span>' +
          '<span class="c">' + x.c + '</span>' +
          '<span class="b"><i style="width:' + Math.max((x.c / max) * 100, 3) + '%"></i></span></li>';
      }).join('');
      host.innerHTML = html;
    }

    /* ---------------- 渲染：KPI ---------------- */
    function renderKpis(a) {
      var t = a.totals;
      var today = a.today;
      var yest = a.yesterday;
      var delta = yest ? Math.round(((today - yest) / yest) * 100) : null;
      var html = [
        { v: t.visitors, u: '位', l: '访客（去重）', note: '' },
        { v: t.sessions, u: '次', l: '访问会话', note: delta === null ? '' : '今日 ' + today + ' · 昨日 ' + yest, cls: delta > 0 ? 'up' : delta < 0 ? 'down' : '' },
        { v: t.views, u: '页', l: '页面浏览', note: '人均 ' + (t.sessions ? (t.views / t.sessions).toFixed(1) : '0') + ' 页' },
        { v: fmtDur(t.avgStay), u: '', l: '平均停留', note: '中位 ' + fmtDur(t.medianStay) },
        { v: pct(t.deep, t.sessions) + '%', u: '', l: '深度阅读（>60 秒）', note: t.deep + ' 次会话' },
        { v: pct(t.returningVisitors, t.visitors) + '%', u: '', l: '回访访客', note: t.newVisitors + ' 位新访客' },
      ].map(function (it) {
        return '<div class="vd__kpi"><b>' + esc(it.v) + (it.u ? '<small>' + it.u + '</small>' : '') + '</b>' +
          '<span>' + it.l + '</span>' +
          (it.note ? '<i class="' + (it.cls || '') + '">' + esc(it.note) + '</i>' : '') + '</div>';
      }).join('');
      el('vd-kpis').innerHTML = html;
    }

    /* ---------------- 渲染：趋势图 ---------------- */
    function renderTrend(a) {
      var host = el('vd-trend');
      var pts = a.series;
      if (!pts.length) { host.innerHTML = '<p class="vd__empty">这个时间段还没有数据</p>'; return; }
      var W = 620, H = 190, P = 26, B = 26;
      var maxV = Math.max.apply(null, pts.map(function (p) { return p.sessions; })) || 1;
      var bw = (W - P * 2) / pts.length;
      var barW = Math.max(2, Math.min(20, bw * 0.55));
      var y = function (v) { return H - B - (v / maxV) * (H - B - 12); };

      var bars = pts.map(function (p, i) {
        var x = P + i * bw + (bw - barW) / 2;
        var h = Math.max(1, (H - B) - y(p.sessions));
        return '<rect x="' + x.toFixed(1) + '" y="' + ((H - B) - h).toFixed(1) + '" width="' + barW.toFixed(1) +
          '" height="' + h.toFixed(1) + '" fill="var(--ai)" opacity="0.22" rx="1.5"><title>' + esc(p.label + '：' + p.sessions + ' 次访问 / ' + p.visitors + ' 位访客') + '</title></rect>';
      }).join('');

      var line = pts.map(function (p, i) {
        var x = P + i * bw + bw / 2;
        return (i ? 'L' : 'M') + x.toFixed(1) + ' ' + y(p.visitors).toFixed(1);
      }).join(' ');

      var dots = pts.map(function (p, i) {
        var x = P + i * bw + bw / 2;
        return '<circle cx="' + x.toFixed(1) + '" cy="' + y(p.visitors).toFixed(1) + '" r="2.4" fill="var(--shu)"><title>' +
          esc(p.label + '：' + p.visitors + ' 位访客') + '</title></circle>';
      }).join('');

      var every = Math.ceil(pts.length / 7);
      var labels = pts.map(function (p, i) {
        if (i % every) return '';
        var x = P + i * bw + bw / 2;
        return '<text x="' + x.toFixed(1) + '" y="' + (H - 6) + '" font-size="9" fill="var(--ink-3)" text-anchor="middle">' + esc(p.label) + '</text>';
      }).join('');

      host.innerHTML = '<svg viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="访问趋势">' +
        '<line x1="' + P + '" y1="' + (H - B) + '" x2="' + (W - P) + '" y2="' + (H - B) + '" stroke="var(--rule)" stroke-width="1"/>' +
        bars +
        '<path d="' + line + '" fill="none" stroke="var(--shu)" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" opacity="0.85"/>' +
        dots + labels +
        '<text x="' + P + '" y="10" font-size="9" fill="var(--ink-3)">峰值 ' + maxV + ' 次/天</text>' +
        '</svg>';
    }

    /* ---------------- 渲染：时段分布 ---------------- */
    function renderHours(a) {
      var host = el('vd-hours');
      var arr = a.hourly;
      var W = 380, H = 190, P = 8, B = 24;
      var maxV = Math.max.apply(null, arr) || 1;
      var bw = (W - P * 2) / 24;
      var bars = arr.map(function (v, h) {
        var barH = Math.max(1, (v / maxV) * (H - B - 18));
        var hot = v >= maxV * 0.72;
        return '<rect x="' + (P + h * bw + 1).toFixed(1) + '" y="' + (H - B - barH).toFixed(1) + '" width="' + (bw - 2).toFixed(1) +
          '" height="' + barH.toFixed(1) + '" rx="1.5" fill="' + (hot ? 'var(--shu)' : 'var(--ai)') + '" opacity="' + (hot ? 0.8 : 0.28) + '">' +
          '<title>' + h + ':00 — ' + v + ' 次</title></rect>';
      }).join('');
      var labels = [0, 6, 12, 18, 23].map(function (h) {
        return '<text x="' + (P + h * bw + bw / 2).toFixed(1) + '" y="' + (H - 6) + '" font-size="9" fill="var(--ink-3)" text-anchor="middle">' + h + '</text>';
      }).join('');
      host.innerHTML = '<svg viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="时段分布">' +
        '<line x1="' + P + '" y1="' + (H - B) + '" x2="' + (W - P) + '" y2="' + (H - B) + '" stroke="var(--rule)" stroke-width="1"/>' +
        bars + labels + '</svg>';
    }

    /* ---------------- 渲染：自动分析 ---------------- */
    function renderInsights(a) {
      var out = [];
      var t = a.totals;
      var days = state.days;

      // 1. 今日 vs 昨日
      if (a.yesterday > 0 || a.today > 0) {
        var d = a.yesterday ? Math.round(((a.today - a.yesterday) / a.yesterday) * 100) : 0;
        var word = d > 0 ? '增长' : d < 0 ? '回落' : '持平';
        out.push({
          ico: d >= 0 ? '📈' : '📉',
          cls: d > 40 ? 'good' : d < -30 ? 'warn' : '',
          b: '今天 ' + a.today + ' 次访问，昨日 ' + a.yesterday + ' 次',
          p: d === 0
            ? '两天基本持平。' + (a.today < 3 ? '样本还小，单日波动不必过度解读。' : '')
            : '相比昨天' + word + ' ' + Math.abs(d) + '%。' + (d > 60 ? '有明显的传播在起作用（朋友圈/群转发的典型形态），可以趁热把最想让人听到的国家页放到分享文案里。' : ''),
        });
      }

      // 2. 高峰时段
      var peak = a.hourly.indexOf(Math.max.apply(null, a.hourly));
      var peakShare = pct(a.hourly[peak], t.sessions);
      if (t.sessions >= 5) {
        out.push({
          ico: '🕘',
          b: '收听高峰在 ' + peak + ':00 – ' + (peak + 1) + ':00（占 ' + peakShare + '%）',
          p: '夜间时段是这类「躺着听」场景的黄金档。想把新功能/新国家推出去，挑这个时段发朋友圈，打开率最高。',
        });
      }

      // 3. 设备结构
      var mobileShare = pct(a.devices.mobile, t.sessions);
      var wechat = a.browsers.filter(function (x) { return /wechat/i.test(x.k); })[0];
      if (t.sessions >= 3) {
        out.push({
          ico: '📱',
          cls: mobileShare > 80 ? 'warn' : '',
          b: '移动端占 ' + mobileShare + '%' + (wechat ? '，其中微信内置浏览器 ' + pct(wechat.c, t.sessions) + '%' : ''),
          p: mobileShare > 80
            ? '这是「一个手机页面」，不是「也支持手机」的桌面站。任何桌面端才有的效果，在这里都不该是主角；字号、按钮、首屏高度都该按手机来定。'
            : '桌面与手机都有一定比例，两套版式都得站得住。',
        });
      }

      // 4. 停留与跳出
      var quick = a.durationBars[0] ? a.durationBars[0].c : 0;
      if (t.sessions >= 5) {
        out.push({
          ico: '⏱',
          cls: quick / t.sessions > 0.45 ? 'warn' : 'good',
          b: '平均停留 ' + fmtDur(t.avgStay) + '，' + pct(quick, t.sessions) + '% 的访问不到 10 秒',
          p: quick / t.sessions > 0.45
            ? '短访问偏多：多半是「点开看一眼就走」，或微信/短信里的链接预览触发了加载。可以在首屏更早露出「一点就响」的电台入口，把路人留住。'
            : '大部分人留下来了，说明首屏抓人。可以把停留最久的国家页挑出来，学着它的节奏做别的页。',
        });
      }

      // 5. 回访
      if (t.visitors >= 5) {
        out.push({
          ico: '🔁',
          b: '回访访客 ' + t.returningVisitors + ' 位（占 ' + pct(t.returningVisitors, t.visitors) + '%）',
          p: t.returningVisitors / t.visitors > 0.3
            ? '有相当比例的人回来了 —— 这是内容站最难得的信号。可以考虑做「我的收藏 / 最近收听」把回访变成习惯。'
            : '目前仍以「一次性到访」为主。留言板、收藏夹这类能沉淀的东西，是把一次性访客变成长客的关键。',
        });
      }

      // 6. 来源
      if (a.sources.length) {
        var top = a.sources[0];
        out.push({
          ico: '🔗',
          b: '主要来源：' + pretty(top.k) + '（' + pct(top.c, t.sessions) + '%）',
          p: /direct/i.test(top.k) || top.k === '(direct)'
            ? '大量「直接打开」在微信里很常见：朋友圈、群聊、聊天窗口的链接都不带 referrer。所以实际传播源头要看播放最多的国家和城市分布来反推。'
            : '外部引荐占主导，说明链接是被「放到别处」再点进来的，值得盯住那个来源的转化。',
        });
      }

      // 7. 播放最多的电台
      if (a.stations.length) {
        var s0 = a.stations[0];
        out.push({
          ico: '📻',
          b: '被点播最多的电台：' + s0.k + '（' + s0.c + ' 次）',
          p: a.stations.length > 1
            ? '第二是 ' + a.stations[1].k + '（' + a.stations[1].c + ' 次）。两台的差距越大，说明这个国家/流派越该往前提。'
            : '目前只有这一个台被点过，可以在它附近再补同风格的台。',
        });
      }

      // 8. 地域集中度
      if (a.cities.length >= 2) {
        var top3 = a.cities.slice(0, 3);
        var share3 = pct(sum(top3.map(function (x) { return x.c; })), t.sessions);
        out.push({
          ico: '📍',
          b: '访客集中在 ' + top3.map(function (x) { return x.k; }).join('、') + '（合计 ' + share3 + '%）',
          p: share3 > 70
            ? '地域高度集中：这更像是「熟人的一次转发」而不是自然流量。想扩大，得靠能被二次转发的钩子（比如某国的独家电台、歌单）。'
            : '访客分布比较散，来源面更宽，适合按大区做内容。',
        });
      }

      // 9. 数据完整性提示
      if (state.mode === 'legacy') {
        out.push({
          ico: '🔓',
          cls: 'warn',
          b: '当前是脱敏模式',
          p: '这次看到的是打码 IP 与较少字段。在 Supabase 执行 supabase/analytics-v2.sql，再用其中设置的口令进站，即可看到真实 IP、运营商、设备型号与每次会话的页面/播放序列。',
        });
      }

      el('vd-insights').innerHTML = out.map(function (x) {
        return '<div class="vd__insight ' + (x.cls ? 'vd__insight--' + x.cls : '') + '">' +
          '<span class="ico" aria-hidden="true">' + x.ico + '</span>' +
          '<div><b>' + esc(x.b) + '</b><p>' + esc(x.p) + '</p></div></div>';
      }).join('');
    }

    /* ---------------- 分析：把明细折成一份结论 ---------------- */
    function analyze(rows) {
      var now = new Date();
      var startOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();

      var t = { sessions: rows.length, visitors: 0, views: 0, avgStay: 0, medianStay: 0, deep: 0, newVisitors: 0, returningVisitors: 0 };

      var visitorCount = {};
      rows.forEach(function (r) {
        var v = r.visitor_id || ipOf(r) || 'anon';
        visitorCount[v] = (visitorCount[v] || 0) + 1;
        t.views += Number(r.views) || 1;
      });
      var vkeys = Object.keys(visitorCount);
      t.visitors = vkeys.length;
      t.returningVisitors = vkeys.filter(function (k) { return visitorCount[k] > 1; }).length;
      t.newVisitors = t.visitors - t.returningVisitors;

      var staysArr = rows.map(stays).filter(function (x) { return x > 0; }).sort(function (a, b) { return a - b; });
      t.avgStay = staysArr.length ? Math.round(sum(staysArr) / staysArr.length) : 0;
      t.medianStay = staysArr.length ? staysArr[Math.floor(staysArr.length / 2)] : 0;
      t.deep = rows.filter(function (r) { return stays(r) > 60000; }).length;

      // 每日序列
      var byDay = {};
      rows.forEach(function (r) {
        var d = new Date(r.started_at);
        if (isNaN(d)) return;
        var k = d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
        if (!byDay[k]) byDay[k] = { sessions: 0, set: {} };
        byDay[k].sessions++;
        byDay[k].set[r.visitor_id || ipOf(r) || 'anon'] = 1;
      });
      var dayKeys = Object.keys(byDay).sort();
      var span = Math.min(state.days === 3650 ? 90 : state.days, 90);
      var series = [];
      for (var i = span - 1; i >= 0; i--) {
        var d = new Date(startOfToday - i * 86400000);
        var k = d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
        var hit = byDay[k];
        series.push({ label: fmtDay(d), sessions: hit ? hit.sessions : 0, visitors: hit ? Object.keys(hit.set).length : 0 });
      }

      // 时段
      var hourly = new Array(24).fill(0);
      rows.forEach(function (r) {
        var d = new Date(r.started_at);
        if (!isNaN(d)) hourly[d.getHours()]++;
      });

      var today = series.length ? series[series.length - 1].sessions : 0;
      var yesterday = series.length > 1 ? series[series.length - 2].sessions : 0;

      // 时段分布（时长）
      var buckets = [
        { k: '不足 10 秒', min: 0, max: 10000 },
        { k: '10–30 秒', min: 10000, max: 30000 },
        { k: '30–60 秒', min: 30000, max: 60000 },
        { k: '1–3 分钟', min: 60000, max: 180000 },
        { k: '3–10 分钟', min: 180000, max: 600000 },
        { k: '10 分钟以上', min: 600000, max: Infinity },
      ];
      var durationBars = buckets.map(function (b) {
        return { k: b.k, c: rows.filter(function (r) { return stays(r) >= b.min && stays(r) < b.max; }).length };
      });

      var scrollBars = [
        { k: '几乎没滚动 (<10%)', test: function (s) { return s < 10; } },
        { k: '10–35%', test: function (s) { return s >= 10 && s < 35; } },
        { k: '35–70%', test: function (s) { return s >= 35 && s < 70; } },
        { k: '读到 70% 以上', test: function (s) { return s >= 70; } },
      ].map(function (b) {
        return { k: b.k, c: rows.filter(function (r) { return b.test(Number(r.scroll_pct) || 0); }).length };
      });

      // 播放/点击目标：full 模式有 targets 数组；legacy 没有
      var targets = [];
      rows.forEach(function (r) {
        if (Array.isArray(r.targets)) targets = targets.concat(r.targets);
        else if (r.target) targets.push(r.target);
      });
      var stations = countBy(targets.map(function (x) { return { target: x }; }), function (r) { return r.target; });

      return {
        totals: t,
        today: today,
        yesterday: yesterday,
        series: series,
        hourly: hourly,
        durationBars: durationBars,
        scrollBars: scrollBars,
        devices: { mobile: rows.filter(function (r) { return r.device === 'mobile'; }).length },
        browsers: countBy(rows, function (r) { return r.browser; }),
        sources: countBy(rows, function (r) { return r.ref_host || '(direct)'; }),
        pages: countBy(rows, function (r) { return r.path || '/'; }),
        stations: stations,
        cities: countBy(rows, function (r) {
          if (!r.city && !r.region && !r.country) return null;
          return [r.country, r.region, r.city].filter(Boolean).join(' · ');
        }),
      };
    }

    /* ---------------- 渲染：明细表 ---------------- */
    function filteredRows() {
      var q = state.q.trim().toLowerCase();
      var rows = state.rows.filter(function (r) {
        if (!q) return true;
        return [ipOf(r), r.city, r.region, r.country, r.path, r.ref_host, r.browser, r.os, r.ua]
          .filter(Boolean).join(' ').toLowerCase().indexOf(q) >= 0;
      });
      var key = state.sort;
      var dir = state.dir;
      rows = rows.slice().sort(function (a, b) {
        var va, vb;
        if (key === 'stay') { va = stays(a); vb = stays(b); }
        else if (key === 'scroll') { va = Number(a.scroll_pct) || 0; vb = Number(b.scroll_pct) || 0; }
        else { va = +new Date(a.started_at) || 0; vb = +new Date(b.started_at) || 0; }
        return (va - vb) * dir;
      });
      return rows;
    }

    function renderTable() {
      var rows = filteredRows();
      var size = state.size;
      var pages = Math.max(1, Math.ceil(rows.length / size));
      if (state.page > pages) state.page = pages;
      var slice = rows.slice((state.page - 1) * size, state.page * size);

      el('vd-count').textContent = '共 ' + rows.length + ' 条' + (rows.length !== state.rows.length ? '（已筛选，全部 ' + state.rows.length + ' 条）' : '');

      var head = '<div class="vd__row vd__row--head">' +
        '<span data-sort="time">时间 ' + (state.sort === 'time' ? (state.dir < 0 ? '↓' : '↑') : '') + '</span>' +
        '<span>地区</span><span>IP</span><span>设备 / 系统</span><span>来源</span><span>落地页</span>' +
        '<span data-sort="stay">停留 ' + (state.sort === 'stay' ? (state.dir < 0 ? '↓' : '↑') : '') + '</span>' +
        '<span data-sort="scroll">滚动 ' + (state.sort === 'scroll' ? (state.dir < 0 ? '↓' : '↑') : '') + '</span>' +
        '</div>';

      if (!slice.length) {
        el('vd-table').innerHTML = head + '<div class="vd__row"><span style="grid-column:1/-1">没有匹配的记录</span></div>';
      } else {
        el('vd-table').innerHTML = head + slice.map(function (r) {
          var region = [flag(r.country_code), r.city || r.region || r.country || '未知'].filter(Boolean).join(' ');
          var ip = ipOf(r) || '—';
          var dev = devIcon(r.device) + ' ' + (r.os || '') + ' · ' + (r.browser || '');
          var stay = fmtDur(stays(r));
          var scroll = (Number(r.scroll_pct) || 0) + '%';
          var acts = Array.isArray(r.targets) && r.targets.length ? ' <span class="d" title="' + esc(r.targets.join(' / ')) + '">· ' + r.targets.length + ' 个动作</span>' : '';
          return '<div class="vd__row">' +
            '<span class="t">' + esc(fmtTime(r.started_at)) + '</span>' +
            '<span class="g" title="' + esc([r.country, r.region, r.city].filter(Boolean).join(' · ')) + '">' + esc(region) + '</span>' +
            '<button class="ip" data-ip="' + esc(ip) + '" title="点击复制 · ' + esc(r.ua || '') + '">' + esc(ip) + '</button>' +
            '<span class="s" title="' + esc(r.ua || '') + '">' + esc(dev) + '</span>' +
            '<span class="s">' + esc(pretty(r.ref_host)) + '</span>' +
            '<span class="s" title="' + esc(r.path || '') + '">' + esc(r.path || '/') + acts + '</span>' +
            '<span class="st">' + esc(stay) + '</span>' +
            '<span class="n2">' + esc(scroll) + '</span>' +
            '</div>';
        }).join('');
      }

      el('vd-pager').innerHTML =
        '<button id="vd-prev"' + (state.page <= 1 ? ' disabled' : '') + '>上一页</button>' +
        '<span>第 ' + state.page + ' / ' + pages + ' 页</span>' +
        '<button id="vd-next"' + (state.page >= pages ? ' disabled' : '') + '>下一页</button>';

      var prev = el('vd-prev'), next = el('vd-next');
      if (prev) prev.onclick = function () { state.page--; renderTable(); };
      if (next) next.onclick = function () { state.page++; renderTable(); };

      Array.prototype.forEach.call(el('vd-table').querySelectorAll('.ip'), function (btn) {
        btn.onclick = function () {
          var v = btn.getAttribute('data-ip');
          if (!v) return;
          try {
            navigator.clipboard.writeText(v);
            var old = btn.textContent;
            btn.textContent = '已复制';
            setTimeout(function () { btn.textContent = old; }, 900);
          } catch (e) {}
        };
      });
    }

    /* ---------------- 总渲染 ---------------- */
    function render() {
      var rows = state.rows;
      var a = analyze(rows);
      renderKpis(a);
      renderTrend(a);
      renderHours(a);
      renderInsights(a);

      bars('vd-device', countBy(rows, function (r) {
        return r.device === 'mobile' ? '📱 手机' : r.device === 'tablet' ? '📲 平板' : r.device === 'bot' ? '🤖 机器人' : '🖥 电脑';
      }), 6);

      bars('vd-browser', countBy(rows, function (r) { return r.browser; }), 8);
      bars('vd-os', countBy(rows, function (r) { return r.os; }), 8);
      bars('vd-lang', countBy(rows, function (r) { return r.lang; }), 6);
      bars('vd-sources', a.sources, 8);
      bars('vd-pages', a.pages, 8);
      bars('vd-stations', a.stations, 8);
      bars('vd-net', countBy(rows, function (r) {
        if (r.asn) return 'AS' + r.asn;
        return r.colo ? 'CF ' + r.colo : null;
      }), 6, function (x) { return x.k; });

      bars('vd-country', countBy(rows, function (r) {
        if (!r.country && !r.country_code) return null;
        return flag(r.country_code) + ' ' + (r.country || r.country_code);
      }), 8, function (x) { return x.k; });

      bars('vd-city', countBy(rows, function (r) { return r.city || r.region || null; }), 8, function (x) { return x.k; });
      bars('vd-duration', a.durationBars, 6, function (x) { return x.k; });
      bars('vd-scroll', a.scrollBars, 4, function (x) { return x.k; });

      renderTable();
    }

    /* ---------------- 取数 ---------------- */
    function loading(on) {
      el('vd-meta').textContent = on ? '正在加载…' : el('vd-meta').textContent;
    }

    function load(key, days) {
      state.key = key;
      state.days = days || state.days;
      state.page = 1;
      loading(true);
      var url = '/api/visitors?key=' + encodeURIComponent(key) + '&days=' + state.days + '&limit=' + MAX_ROWS;
      fetch(url)
        .then(function (r) { return r.json().then(function (j) { return { status: r.status, body: j }; }); })
        .then(function (res) {
          var j = res.body || {};
          if (res.status === 401) {
            fail('口令不对。');
            try { sessionStorage.removeItem(KEY_STORE); } catch (e) {}
            gate.hidden = false; body.hidden = true;
            return;
          }
          if (res.status === 403 && j.error === 'not_configured') {
            fail('接口还没配口令。去 Cloudflare Pages → 项目 musicradio → Settings → Variables and Secrets，' +
              '新增一个变量 VISITS_TOKEN（值随便一串 30 位的随机字符），保存后到 Deployments 点 Retry deployment，再回来刷新本页。');
            return;
          }
          if (j.error === 'stats_unavailable') {
            fail('数据表还没建。去 Supabase → SQL Editor，把仓库里的 supabase/analytics-v2.sql 整段粘贴执行一次即可。' +
              (j.hint ? '（诊断：' + j.hint + '）' : ''));
            return;
          }
          if (!j.rows) { fail('加载失败，稍后再试。'); return; }

          try { sessionStorage.setItem(KEY_STORE, key); } catch (e) {}
          gate.hidden = true; body.hidden = false;
          msg.textContent = ''; msg.classList.remove('ok');

          state.mode = j.mode || 'legacy';
          state.rows = j.rows || [];
          state.total = j.total || state.rows.length;

          el('vd-banner').hidden = state.mode !== 'legacy';
          if (state.mode === 'legacy') el('vd-banner').textContent = j.hint || '';

          var spanText = state.days === 3650 ? '全部时间' : '最近 ' + state.days + ' 天';
          el('vd-meta').textContent = spanText + ' · ' + state.rows.length + ' 条会话（服务端共 ' + state.total + ' 条）· ' +
            (state.mode === 'full' ? '完整模式（真实 IP）' : '脱敏模式') +
            ' · 更新于 ' + fmtTime(j.generated_at);
          render();
        })
        .catch(function () { fail('网络错误，稍后再试。'); });
    }

    function fail(text) {
      msg.textContent = text;
      msg.classList.remove('ok');
    }

    document.getElementById('vd-go').addEventListener('click', function () {
      var v = (input.value || '').trim();
      if (!v) { fail('请先输入口令。'); return; }
      msg.textContent = '验证中…'; msg.classList.add('ok');
      load(v, state.days);
    });
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') document.getElementById('vd-go').click();
    });
    document.getElementById('vd-exit').addEventListener('click', function () {
      try { sessionStorage.removeItem(KEY_STORE); } catch (e) {}
      body.hidden = true; gate.hidden = false; input.value = ''; msg.textContent = '';
    });
    document.getElementById('vd-refresh').addEventListener('click', function () {
      if (state.key) load(state.key, state.days);
    });

    Array.prototype.forEach.call(document.querySelectorAll('#vd-range button'), function (b) {
      b.addEventListener('click', function () {
        Array.prototype.forEach.call(document.querySelectorAll('#vd-range button'), function (x) { x.classList.remove('is-on'); });
        b.classList.add('is-on');
        state.days = Number(b.getAttribute('data-days')) || 30;
        try { localStorage.setItem(DAYS_STORE, String(state.days)); } catch (e) {}
        if (state.key) load(state.key, state.days);
      });
    });

    document.getElementById('vd-q').addEventListener('input', function (e) {
      state.q = e.target.value || '';
      state.page = 1;
      renderTable();
    });
    document.getElementById('vd-size').addEventListener('change', function (e) {
      state.size = Number(e.target.value) || 50;
      state.page = 1;
      renderTable();
    });
    document.getElementById('vd-table').addEventListener('click', function (e) {
      var t = e.target.closest('[data-sort]');
      if (!t) return;
      var k = t.getAttribute('data-sort');
      if (state.sort === k) state.dir = -state.dir;
      else { state.sort = k; state.dir = -1; }
      renderTable();
    });

    document.getElementById('vd-csv').addEventListener('click', function () {
      var rows = filteredRows();
      var cols = ['started_at', 'ip', 'country', 'region', 'city', 'device', 'os', 'browser', 'lang', 'screen',
        'ref_host', 'path', 'stay_ms', 'scroll_pct', 'views', 'actions', 'timezone', 'colo', 'asn', 'ua', 'visitor_id'];
      var head = cols.join(',');
      var body2 = rows.map(function (r) {
        return cols.map(function (c) {
          var v = c === 'ip' ? ipOf(r) : r[c];
          if (Array.isArray(v)) v = v.join(' | ');
          v = v == null ? '' : String(v);
          return '"' + v.replace(/"/g, '""') + '"';
        }).join(',');
      }).join('\n');
      var blob = new Blob(['\ufeff' + head + '\n' + body2], { type: 'text/csv;charset=utf-8' });
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'musicradio-visits-' + new Date().toISOString().slice(0, 10) + '.csv';
      a.click();
      URL.revokeObjectURL(a.href);
    });

    // 记住上次的时间范围
    try {
      var d = Number(localStorage.getItem(DAYS_STORE));
      if (d) {
        state.days = d;
        Array.prototype.forEach.call(document.querySelectorAll('#vd-range button'), function (x) {
          x.classList.toggle('is-on', Number(x.getAttribute('data-days')) === d);
        });
      }
    } catch (e) {}

    try {
      var saved = sessionStorage.getItem(KEY_STORE);
      if (saved) load(saved, state.days);
    } catch (e) {}
  })();
</script>
