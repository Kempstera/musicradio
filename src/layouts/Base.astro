---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BirthdayEgg from '../components/BirthdayEgg.tsx';
import { SITE_NAME, SITE_URL } from '../lib/config';
import { t0 } from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
  /** 站长专用页面（如 /visits）：加 noindex，避免被搜索引擎收录 */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
// 静态 HTML 一律以**默认语言（英语）**预渲染，与 i18n 的 DEFAULT_LANG 保持一致：
// 首屏不会出现「先中文再跳英语」的闪烁，任何人从任何地方首次进入看到的都是英语。
const fullTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} · World Music Radio`;
const desc = description || t0.heroDesc;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f2e9" />
    <script is:inline>
      // ① 标记 JS 可用：滚动进场等「先隐藏后显现」的效果只在这个类存在时生效，
      //    脚本一旦失效，内容会以正常状态呈现，而不是永远透明。
      document.documentElement.classList.add('js');

      // ② 语言初始化 + 「水合竞速」防护：
      //    尽早按 localStorage 设置 <html lang>，避免 SSR 英语 → 用户已选语言的错位与闪烁；
      //    没有存过语言（首次来访）就保持默认的 en。
      // ③ React 岛（LanguageSwitcher）水合完成之前，用户若已在切换器里选了语言，
      //    原生 change 监听器会先把选择落盘并暂存 —— 否则这次选择会被水合时的
      //    初始 state 静默覆盖（表现为：切换器显示新语言，但页面文案没跟着变）。
      (function () {
        var LANGS = ['en', 'cy', 'zh-CN', 'zh-TW', 'fr', 'de', 'it', 'es'];
        var DEFAULT = 'en';
        var saved = null;
        try {
          saved = window.localStorage.getItem('mr_lang');
        } catch (e) {}
        var ok = saved && LANGS.indexOf(saved) >= 0;
        document.documentElement.setAttribute('lang', ok ? saved : DEFAULT);
        // 从没选过语言的访客：给语言切换器挂一个「可切换」的呼吸标识
        if (!ok) document.documentElement.classList.add('mr-lang-fresh');

        // 捕获阶段监听：早于 React 的合成事件处理器执行
        document.addEventListener(
          'change',
          function (ev) {
            var t = ev.target;
            if (!t || t.tagName !== 'SELECT' || !t.closest || !t.closest('.lang-switcher')) return;
            var lang = t.value;
            if (LANGS.indexOf(lang) < 0) return;
            try {
              window.localStorage.setItem('mr_lang', lang);
            } catch (e) {}
            document.documentElement.setAttribute('lang', lang);
            document.documentElement.classList.remove('mr-lang-fresh');
            if (window.__mrLangReady) return; // 已水合：后续交给 LanguageSwitcher.onChange
            window.__mrLangPending = lang; // 暂存，水合时由 LanguageSwitcher 采纳
            window.__mrUserLangChange = { lang: lang, at: Date.now() };
            if (typeof window.__mrApplyLang === 'function') window.__mrApplyLang(lang);
          },
          true
        );
      })();
    </script>
    <style is:inline>
      /* 老访客带着「非英语」的选择进来时，HTML 里预渲染的仍是英语。
         先把内容压住（body 占位不变、不会跳动），等语言落地再由脚本撤掉，
         否则打开任何一页都会先闪一大片英文。脚本失效时下面有 2.5s 兜底。 */
      html.mr-i18n-pending body {
        opacity: 0;
      }
      body {
        transition: opacity 0.18s ease;
      }
    </style>
    <script is:inline>
      (function () {
        try {
          var s = window.localStorage.getItem('mr_lang');
          if (!s || s === 'en') return;
          document.documentElement.classList.add('mr-i18n-pending');
          window.__mrI18nTimer = setTimeout(function () {
            document.documentElement.classList.remove('mr-i18n-pending');
          }, 2500);
        } catch (e) {}
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {/* 站点图标：朱地上一道对称的声波。SVG 给现代浏览器，PNG 兜底，
        apple-touch-icon 是不带圆角的全幅红块 —— iOS 自己会切圆角，图里再切一层会露出缺口。 */}
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f6f2e9" />
    <link rel="canonical" href={SITE_URL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    {/* 页面可以往 head 里塞「必须在首帧之前跑」的内联脚本（如首页的首访过场） */}
    <slot name="head" />
  </head>
  <body>
    <Header />
    <script>
      // 页面一解析完就把「已选语言」铺到全站文案上 —— 不等 React 水合。
      // 这段是整个语言一致性的主力：即使某个岛加载失败，页面也已经是正确语言。
      import { applySavedLang } from '../lib/apply-lang';
      applySavedLang();
    </script>
    <script is:inline>
      // 在 HTML 解析阶段就把切换器选中项对齐到已保存语言，
      // 避免「HTML 已渲染 → React 水合完成」这段时间里下拉框显示错误的语言
      (function () {
        try {
          var s = window.localStorage.getItem('mr_lang');
          if (!s) return;
          var sel = document.querySelector('.lang-switcher select');
          if (sel && sel.querySelector('option[value="' + s + '"]')) sel.value = s;
        } catch (e) {}
      })();
    </script>
    <BirthdayEgg client:load />
    <slot />
    <Footer />

    <!-- 阅读进度：顶部一道藍色细线，随读到哪儿生长。纯装饰，aria-hidden -->
    <div class="readline" aria-hidden="true"><i></i></div>

    <script is:inline>
      // ── 阅读进度 ──────────────────────────────────────────────────
      // 用 transform: scaleX 而不是 width，避免每帧触发布局。
      (function () {
        var bar = document.querySelector('.readline i');
        var docEl = document.documentElement;
        var ticking = false;

        function render() {
          ticking = false;
          if (!bar) return;
          var max = docEl.scrollHeight - window.innerHeight;
          var p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
          bar.style.transform = 'scaleX(' + p + ')';
        }

        function request() {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(render);
          }
        }

        window.addEventListener('scroll', request, { passive: true });
        window.addEventListener('resize', request);
        request();

        // ── 头部高度同步 ──────────────────────────────────────────
        // 导航在窄屏会折成两行，实际高度不再等于 CSS 里的 --header-h。
        // 用实测值回写变量，body 的占位与吸附条的 top 才不会错位。
        function syncHeader() {
          var hdr = document.querySelector('.site-header');
          if (hdr) docEl.style.setProperty('--header-h', hdr.offsetHeight + 'px');
        }
        syncHeader();
        window.addEventListener('resize', syncHeader);
        window.addEventListener('load', syncHeader);
        // 字体与语言岛水合都可能再改变一点高度，补两次测量
        setTimeout(syncHeader, 300);
        setTimeout(syncHeader, 1200);

        // ── 滚动进场 ──────────────────────────────────────────────
        var targets = document.querySelectorAll('[data-reveal]');
        if (!targets.length) return;

        if (!('IntersectionObserver' in window)) {
          for (var i = 0; i < targets.length; i++) targets[i].classList.add('is-in');
          return;
        }

        var io = new IntersectionObserver(
          function (entries) {
            for (var j = 0; j < entries.length; j++) {
              if (entries[j].isIntersecting) {
                entries[j].target.classList.add('is-in');
                io.unobserve(entries[j].target);
              }
            }
          },
          // threshold 0 + 只收 8%：只要露出一点点就显现。
          // 收得太狠（-12%）会让「刚好在首屏底边」的区块标题看起来像空白洞。
          { rootMargin: '0px 0px -8% 0px', threshold: 0 }
        );

        for (var k = 0; k < targets.length; k++) io.observe(targets[k]);

        // 兜底：观察器若因任何原因没回调（无头浏览器截长图、极端视口），
        // 800ms 后把已经在首屏内的元素直接显出来，绝不留下永久隐藏的内容。
        setTimeout(function () {
          for (var m = 0; m < targets.length; m++) {
            if (targets[m].classList.contains('is-in')) continue;
            var r = targets[m].getBoundingClientRect();
            if (r.top < window.innerHeight * 0.98) targets[m].classList.add('is-in');
          }
        }, 800);
      })();
    </script>

    <!-- 访客埋点：页面浏览 / 停留 / 点击 / 播放（详见 public/js/track.js）
         采集是静默的，页面不展示任何访客数据；查看入口在 /visits（仅站长持有口令） -->
    <script is:inline src="/js/track.js" defer></script>
  </body>
</html>
