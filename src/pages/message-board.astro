---
import Base from '../layouts/Base.astro';
import MessageBoard from '../components/MessageBoard.tsx';
import { t0 } from '../lib/i18n';

const title = t0.navGuestbook;
const description = t0.boardPageDesc;
---

<Base title={title} description={description}>
  <section class="explore-head">
    <div class="container">
      <div class="explore-head__inner">
        <div class="section__kicker">Guestbook</div>
        <h1 class="explore-head__title" data-i18n="navGuestbook">{t0.navGuestbook}</h1>
        <p class="explore-head__desc" data-i18n="boardPageDesc">{t0.boardPageDesc}</p>
      </div>
    </div>
  </section>

  <section class="board-body">
    <div class="container container--narrow">
      <MessageBoard client:load />
    </div>
  </section>
</Base>
