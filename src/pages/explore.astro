---
// 大洲巡礼 —— 电台总览页（NIGHT FREQUENCY）
//
// 内容与上一版完全一致：
//   · 生日彩蛋精选集（MarieJukebox，仅彩蛋触发后渲染）
//   · 我的最爱电台列表 + 播放按钮（MyFavorites）
//   · 六大洲 → 子区域 → 国家卡片完整清单
//
// 新增的只有交互层：吸附式频率调谐条 + 国家检索框（195 张卡片，没有检索不好用）。
import Base from '../layouts/Base.astro';
import MarieJukebox from '../components/MarieJukebox.tsx';
import MyFavorites from '../components/MyFavorites.tsx';
import { CONTINENTS, SUBREGIONS } from '../lib/country';
import { allCountries, countriesByContinent, countriesBySubregion } from '../data';
import { getAllCompact } from '../data/i18n';
import { t0, CONTINENT_LABELS, SUBREGION_LABELS } from '../lib/i18n';
import radiosData from '../data/radios.json';

const compact = getAllCompact();
const compactJson = JSON.stringify(compact).replace(/</g, '\\u003c');

const en = compact['en'] || {};
const enLabel = (id: string) => (CONTINENT_LABELS['en'] as Record<string, string>)?.[id];
const subLabel = (id: string) => (SUBREGION_LABELS['en'] as Record<string, string>)?.[id];

// 可在线收听的电台总数（与页脚统计口径一致）
const radios = radiosData as Record<string, any[]>;
const totalRadios = allCountries.reduce((sum, c) => {
  const notable = (c.notableRadios || []).filter((r) => r.url).length;
  const fetched = c.radioMode === 'notable-only' ? 0 : (radios[c.iso] || []).length;
  return sum + notable + fetched;
}, 0);
---

<Base title={t0.navExplore}>
  <script type="application/json" id="content-blob" is:inline set:html={compactJson}></script>

  <section class="explore-head">
    <div class="container">
      <div class="explore-head__inner">
        <div class="section__kicker" data-i18n="exploreKicker">{t0.exploreKicker}</div>
        <h1 class="explore-head__title" data-i18n="exploreTitle">{t0.exploreTitle}</h1>
        <p class="explore-head__desc" data-i18n="heroDesc">{t0.heroDesc}</p>
        <div class="explore-head__stats">
          <span><b>{allCountries.length}</b> <span data-i18n="regionUnit">{t0.regionUnit}</span></span>
          <span class="explore-head__sep" aria-hidden="true">/</span>
          <span><b>{totalRadios}</b> <span data-i18n="favCountUnit">{t0.favCountUnit}</span></span>
        </div>
      </div>
    </div>
  </section>

  {/* 调谐条：桌面端吸附在顶部导航下方，滚到任何深度都能换洲或直接检索。
      必须放在 .explore-head 之外 —— position:sticky 的吸附范围受父容器限制。 */}
  <div class="explore-jumpbar">
    <div class="container explore-jumpbar__inner">
      <nav class="explore-jump" aria-label="Continents">
        {
          CONTINENTS.map((c) => (
            <a class="explore-jump__item" href={`#${c.id}`} data-region={c.id}>
              <span data-continent={c.id}>{enLabel(c.id) || c.label}</span>
              <small>{countriesByContinent(c.id).length}</small>
            </a>
          ))
        }
      </nav>
      <div class="explore-filter">
        <svg class="explore-filter__icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <circle cx="11" cy="11" r="7" /><path d="m20 20-3.6-3.6" />
        </svg>
        <input type="search" class="explore-filter__input" data-i18n="searchPlaceholder" placeholder={t0.searchPlaceholder} aria-label={t0.searchPlaceholder} autocomplete="off" spellcheck="false" />
      </div>
    </div>
  </div>

  {/* 生日彩蛋：切到威尔士语后被注入的「Marie's 1946 Jukebox」出现在这里（未激活时不渲染） */}
  <MarieJukebox client:load />

  <MyFavorites client:load />

  {
    CONTINENTS.map((c, ci) => {
      const continentCountries = countriesByContinent(c.id);
      if (!continentCountries.length) return null;
      const subs = SUBREGIONS.filter((s) => s.continent === c.id);
      return (
        <section class="section explore-sec" id={c.id} data-region={c.id}>
          <div class="container">
            <div class="section__head" data-reveal>
              <div class="explore-sec__lead">
                <span class="explore-sec__num" aria-hidden="true">{String(ci + 1).padStart(2, '0')}</span>
                <div>
                  {/* 英文界面下大洲英文名与标题重复，由 CSS 收起（见 global.css） */}
                  <div class="section__kicker section__kicker--region">{c.en}</div>
                  <h2 class="section__title" data-continent={c.id}>{enLabel(c.id) || c.label}</h2>
                </div>
              </div>
              <span class="explore-sec__count">{continentCountries.length} <span data-i18n="regionUnit">{t0.regionUnit}</span></span>
            </div>

            {
              subs.map((s) => {
                const list = countriesBySubregion(s.id);
                if (!list.length) return null;
                return (
                  <div class="subregion" id={s.id}>
                    <div class="subregion__head">
                      <h3 class="subregion__title" data-subregion={s.id}>{subLabel(s.id) || s.label}</h3>
                      <span class="subregion__en">{s.en}</span>
                      <span class="subregion__count">{list.length} <span data-i18n="subregionUnit">{t0.subregionUnit}</span></span>
                    </div>
                    <div class="country-grid">
                      {
                        list.map((country) => (
                          <a class="country-card" href={`/countries/${country.slug}`} data-region={c.id}>
                            <span class="country-card__flag" aria-hidden="true">{country.flag}</span>
                            <div class="country-card__name" data-ct="name" data-slug={country.slug}>{en[country.slug]?.name || country.name}</div>
                            <div class="country-card__en">{country.nameEn}</div>
                            <p class="country-card__intro" data-ct="intro" data-slug={country.slug}>{en[country.slug]?.intro || country.intro}</p>
                            <span class="country-card__more" data-i18n="listenRadio">{t0.listenRadio}</span>
                          </a>
                        ))
                      }
                    </div>
                  </div>
                );
              })
            }
          </div>
        </section>
      );
    })
  }

  {/* 检索无结果时的提示：比一个孤零零的破折号清楚得多 */}
  <p class="explore-empty" data-i18n="noResults" hidden>{t0.noResults}</p>
</Base>

<script is:inline>
  // 国家检索：只在当前 DOM 上按可见文本过滤，不引入任何数据依赖。
  // 大小写与变音符号一并归一化，这样搜 "peru" 也能命中 "Perú"。
  (function () {
    var input = document.querySelector('.explore-filter__input');
    if (!input) return;

    var cards = Array.prototype.slice.call(document.querySelectorAll('.country-card'));
    var subs = Array.prototype.slice.call(document.querySelectorAll('.subregion'));
    var secs = Array.prototype.slice.call(document.querySelectorAll('.explore-sec'));
    var empty = document.querySelector('.explore-empty');

    function norm(s) {
      return (s || '')
        .toString()
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');
    }

    function textOf(el, sel) {
      var n = el.querySelector(sel);
      return n ? n.textContent : '';
    }

    // 预先算好每张卡的检索文本，输入时不必反复读 DOM
    var haystack = cards.map(function (card) {
      return norm(textOf(card, '.country-card__name') + ' ' + textOf(card, '.country-card__en'));
    });

    function run() {
      var q = norm(input.value).trim();
      var shown = 0;

      for (var i = 0; i < cards.length; i++) {
        var hit = !q || haystack[i].indexOf(q) >= 0;
        cards[i].classList.toggle('is-filtered-out', !hit);
        if (hit) shown++;
      }

      for (var j = 0; j < subs.length; j++) {
        subs[j].classList.toggle(
          'is-filtered-out',
          !subs[j].querySelector('.country-card:not(.is-filtered-out)')
        );
      }

      for (var k = 0; k < secs.length; k++) {
        secs[k].classList.toggle(
          'is-filtered-out',
          !secs[k].querySelector('.country-card:not(.is-filtered-out)')
        );
      }

      if (empty) empty.hidden = shown !== 0;
    }

    input.addEventListener('input', run);
    input.addEventListener('search', run);
  })();
</script>

<style is:global>
  .explore-head {
    padding: clamp(3rem, 7vw, 5.5rem) 0 clamp(1.6rem, 3vw, 2.4rem);
  }
  .explore-head__inner { max-width: 52rem; }
  .explore-head__title {
    font-family: var(--f-display);
    font-size: clamp(2.2rem, 6vw, 4.4rem);
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin: 0.7rem 0 1.1rem;
    text-shadow: 0 0 80px rgba(255, 180, 58, 0.25);
  }
  .explore-head__desc {
    color: var(--ink-2);
    font-size: var(--t-0);
    line-height: 1.8;
    margin: 0;
    max-width: 58ch;
  }
  .explore-head__stats {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin-top: 1.6rem;
    font-family: var(--f-mono);
    font-size: var(--t--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    flex-wrap: wrap;
  }
  .explore-head__stats b {
    color: var(--amber);
    font-size: var(--t--1);
    font-weight: 700;
    text-shadow: 0 0 14px rgba(255, 180, 58, 0.5);
  }
  .explore-head__sep { opacity: 0.35; }

  /* ── 吸附调谐条 ────────────────────────────────────────────── */
  .explore-jumpbar {
    position: sticky;
    top: var(--header-h);
    z-index: 60;
    background: color-mix(in srgb, var(--void) 78%, transparent);
    backdrop-filter: blur(18px) saturate(150%);
    border-bottom: 1px solid var(--hair-2);
  }
  .explore-jumpbar__inner {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding-block: 0.6rem;
  }
  .explore-jump {
    display: flex;
    gap: 0.4rem;
    overflow-x: auto;
    scrollbar-width: none;
    flex: 1 1 auto;
    min-width: 0;
  }
  .explore-jump::-webkit-scrollbar { display: none; }
  .explore-jump__item {
    flex: 1 1 0;
    min-width: 6.4rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.45rem;
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--hair-2);
    border-radius: var(--radius-xs);
    background: rgba(244, 241, 234, 0.02);
    color: var(--ink-2);
    font-family: var(--f-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out);
  }
  .explore-jump__item small {
    color: var(--ink-3);
    font-size: 0.62rem;
  }
  .explore-jump__item:hover {
    border-color: var(--region, var(--amber));
    color: var(--ink);
    background: rgba(255, 180, 58, 0.06);
  }

  .explore-filter {
    position: relative;
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.42rem 0.75rem;
    border: 1px solid var(--hair-2);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.35);
    color: var(--ink-3);
    transition: border-color var(--dur-2) var(--ease-out);
  }
  .explore-filter:focus-within {
    border-color: var(--amber-line);
    box-shadow: 0 0 0 3px rgba(255, 180, 58, 0.1);
  }
  .explore-filter__input {
    width: 11rem;
    border: none;
    background: transparent;
    color: var(--ink);
    font-family: var(--f-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    outline: none;
  }
  .explore-filter__input::placeholder {
    color: var(--ink-3);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .explore-filter__input::-webkit-search-cancel-button { filter: invert(0.6); }

  /* ── 大洲分区 ──────────────────────────────────────────────── */
  .explore-sec { padding-top: clamp(2.6rem, 5vw, 4.5rem); }
  .explore-sec__lead {
    display: flex;
    align-items: baseline;
    gap: clamp(0.8rem, 2vw, 1.6rem);
  }
  /* 分区大序号：一个压得很低的水印数字 */
  .explore-sec__num {
    font-family: var(--f-display);
    font-style: italic;
    font-weight: 900;
    font-size: clamp(2.4rem, 5.4vw, 4.2rem);
    line-height: 0.8;
    color: var(--region, var(--amber));
    opacity: 0.32;
    text-shadow: 0 0 40px var(--region-glow, rgba(255, 180, 58, 0.5));
    flex: none;
  }
  .explore-sec__count {
    font-family: var(--f-mono);
    font-size: var(--t--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    white-space: nowrap;
  }

  /* 检索命中/未命中 */
  .is-filtered-out { display: none !important; }
  .explore-empty {
    text-align: center;
    padding: 6rem 1rem 8rem;
    font-family: var(--f-mono);
    font-size: var(--t--1);
    letter-spacing: 0.3em;
    color: var(--ink-3);
  }

  @media (max-width: 900px) {
    .explore-jumpbar__inner { flex-wrap: wrap; }
    .explore-filter { width: 100%; }
    .explore-filter__input { width: 100%; }
  }

  @media (max-width: 720px) {
    /* 手机端顶部导航会折行、高度不固定，吸附条难以对齐，改为跟随内容滚走 */
    .explore-jumpbar {
      position: static;
      background: transparent;
      backdrop-filter: none;
      border-bottom: 0;
    }
    .explore-jumpbar__inner { padding-block: 0 1rem; }
    .explore-jump__item { min-width: 5.4rem; flex: 0 0 auto; }
    .explore-sec { padding-top: 2rem; }
  }

  /* 从国家页面包屑跳进来时，别让 sticky 头部盖住标题 */
  :where(section[id], .subregion[id]) {
    scroll-margin-top: calc(var(--header-h) + 3.6rem);
  }
</style>
