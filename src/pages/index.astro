---
import Base from '../layouts/Base.astro';
import MarieJukebox from '../components/MarieJukebox.tsx';
import MyFavorites from '../components/MyFavorites.tsx';
import { CONTINENTS, SUBREGIONS, CONTINENT_MAP } from '../lib/country';
import { allCountries, countriesByContinent, countriesBySubregion } from '../data';
import { getAllCompact } from '../data/i18n';
import { t0, CONTINENT_LABELS, SUBREGION_LABELS } from '../lib/i18n';

const compact = getAllCompact();
const compactJson = JSON.stringify(compact).replace(/</g, '\\u003c');

// 静态 HTML 以默认语言（英语）预渲染：国名 / 简介 / 大洲名都取英语版本，
// 与 data-ct / data-continent 上的多语言 blob 对齐（用户切换语言时再由 JS 覆盖）。
const en = compact['en'] || {};
const enLabel = (id: string) => (CONTINENT_LABELS['en'] as Record<string, string>)?.[id];
const subLabel = (id: string) => (SUBREGION_LABELS['en'] as Record<string, string>)?.[id];
---

<Base>
  <script type="application/json" id="content-blob" is:inline set:html={compactJson}></script>
  <section class="hero">
    <div class="container">
      <div class="wave" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
      </div>
      <div class="hero__eyebrow" data-i18n="sloganAttr">{t0.sloganAttr}</div>
      <h1 class="hero__title" data-i18n="slogan">{t0.slogan}</h1>
      <div class="hero__subtitle" data-i18n="subtitle">{t0.subtitle}</div>
      <p class="hero__desc" data-i18n="heroDesc">
        {t0.heroDesc}
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="#continents" data-i18n="start">{t0.start}</a>
        <a class="btn btn--ghost" href="/message-board" data-i18n="guestbookBtn">{t0.guestbookBtn}</a>
      </div>
    </div>
  </section>

  {/* 生日彩蛋：切到威尔士语后，注入的「Marie's 1946 Jukebox」会出现在这里（未激活时不渲染任何内容） */}
  <MarieJukebox client:load />

  <MyFavorites client:load />

  <section class="section" id="continents">
    <div class="container">
      <div class="section__head">
        <div>
          <div class="section__kicker" data-i18n="exploreKicker">{t0.exploreKicker}</div>
          <h2 class="section__title" data-i18n="exploreTitle">{t0.exploreTitle}</h2>
        </div>
        <p style="color: var(--ink-faint);">{allCountries.length} <span data-i18n="exploreCount">{t0.exploreCount}</span></p>
      </div>
      <div class="regions">
        {
          CONTINENTS.map((c) => {
            const n = countriesByContinent(c.id).length;
            const subs = SUBREGIONS.filter((s) => s.continent === c.id);
            return (
              <a class="region-card" href={`#${c.id}`} data-region={c.id}>
                <span class="region-card__name" data-continent={c.id}>{enLabel(c.id) || c.label}</span>
                <span class="region-card__en">{c.en}</span>
                <span class="region-card__count">{n} <span data-i18n="regionUnit">{t0.regionUnit}</span> · {subs.length} <span data-i18n="subdivisionUnit">{t0.subdivisionUnit}</span></span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  {
    CONTINENTS.map((c) => {
      const continentCountries = countriesByContinent(c.id);
      if (!continentCountries.length) return null;
      const subs = SUBREGIONS.filter((s) => s.continent === c.id);
      return (
        <section class="section" id={c.id} data-region={c.id} style="padding-top: 1.6rem;">
          <div class="container">
            <div class="section__head">
              <div>
                <div class="section__kicker">{c.en}</div>
                <h2 class="section__title" data-continent={c.id}>{enLabel(c.id) || c.label}</h2>
              </div>
              <span style="color: var(--ink-faint);">{continentCountries.length} <span data-i18n="regionUnit">{t0.regionUnit}</span></span>
            </div>

            {
              subs.map((s) => {
                const list = countriesBySubregion(s.id);
                if (!list.length) return null;
                return (
                  <div class="subregion" style="margin-top: 1.6rem;">
                    <div class="subregion__head">
                      <h3 class="subregion__title" data-subregion={s.id}>{subLabel(s.id) || s.label}</h3>
                      <span class="subregion__en">{s.en}</span>
                      <span class="subregion__count">{list.length} <span data-i18n="subregionUnit">{t0.subregionUnit}</span></span>
                    </div>
                    <div class="country-grid">
                      {
                        list.map((country) => (
                          <a class="country-card" href={`/countries/${country.slug}`} data-region={c.id}>
                            <span class="country-card__flag" aria-hidden="true">{country.flag}</span>
                            <div class="country-card__name" data-ct="name" data-slug={country.slug}>{en[country.slug]?.name || country.name}</div>
                            <div class="country-card__en">{country.nameEn}</div>
                            <p class="country-card__intro" data-ct="intro" data-slug={country.slug}>{en[country.slug]?.intro || country.intro}</p>
                            <span class="country-card__more" data-i18n="listenRadio">{t0.listenRadio}</span>
                          </a>
                        ))
                      }
                    </div>
                  </div>
                );
              })
            }
          </div>
        </section>
      );
    })
  }
</Base>
