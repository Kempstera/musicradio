---
import Base from '../layouts/Base.astro';
import { CONTINENTS, SUBREGIONS, CONTINENT_MAP } from '../lib/country';
import { allCountries, countriesByContinent, countriesBySubregion } from '../data';
import { getAllCompact } from '../data/i18n';

const compactJson = JSON.stringify(getAllCompact()).replace(/</g, '\\u003c');
---

<Base>
  <script type="application/json" id="content-blob" is:inline set:html={compactJson}></script>
  <section class="hero">
    <div class="container">
      <div class="wave" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
      </div>
      <div class="hero__eyebrow" data-i18n="sloganAttr">白居易《琵琶行》</div>
      <h1 class="hero__title" data-i18n="slogan">如听仙乐耳暂明</h1>
      <div class="hero__subtitle" data-i18n="subtitle">World Music Radio · 一场横跨六大洲的耳朵之旅</div>
      <p class="hero__desc" data-i18n="heroDesc">
        我们搜罗世界各国的音乐电台，以大洲为纲、子区域为目，带你巡礼古典的庄严、爵士的自由、流行的炽热与民族音乐的千年回响。
        点开一个国家，让它的历史人文、音乐家与电台流，在同一片声景里与你相遇。
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="#continents" data-i18n="start">开始巡礼</a>
        <a class="btn btn--ghost" href="/message-board" data-i18n="guestbookBtn">去留言板</a>
      </div>
    </div>
  </section>

  <section class="section" id="continents">
    <div class="container">
      <div class="section__head">
        <div>
          <div class="section__kicker" data-i18n="exploreKicker">Explore</div>
          <h2 class="section__title" data-i18n="exploreTitle">按大洲巡礼</h2>
        </div>
        <p style="color: var(--ink-faint);">{allCountries.length} <span data-i18n="exploreCount">个国家与地区</span></p>
      </div>
      <div class="regions">
        {
          CONTINENTS.map((c) => {
            const n = countriesByContinent(c.id).length;
            const subs = SUBREGIONS.filter((s) => s.continent === c.id);
            return (
              <a class="region-card" href={`#${c.id}`} data-region={c.id}>
                <span class="region-card__name" data-continent={c.id}>{c.label}</span>
                <span class="region-card__en">{c.en}</span>
                <span class="region-card__count">{n} <span data-i18n="regionUnit">个国家/地区</span> · {subs.length} <span data-i18n="subdivisionUnit">个分区</span></span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  {
    CONTINENTS.map((c) => {
      const continentCountries = countriesByContinent(c.id);
      if (!continentCountries.length) return null;
      const subs = SUBREGIONS.filter((s) => s.continent === c.id);
      return (
        <section class="section" id={c.id} data-region={c.id} style="padding-top: 1.6rem;">
          <div class="container">
            <div class="section__head">
              <div>
                <div class="section__kicker">{c.en}</div>
                <h2 class="section__title" data-continent={c.id}>{c.label}</h2>
              </div>
              <span style="color: var(--ink-faint);">{continentCountries.length} <span data-i18n="regionUnit">个国家/地区</span></span>
            </div>

            {
              subs.map((s) => {
                const list = countriesBySubregion(s.id);
                if (!list.length) return null;
                return (
                  <div class="subregion" style="margin-top: 1.6rem;">
                    <div class="subregion__head">
                      <h3 class="subregion__title" data-subregion={s.id}>{s.label}</h3>
                      <span class="subregion__en">{s.en}</span>
                      <span class="subregion__count">{list.length} <span data-i18n="subregionUnit">国</span></span>
                    </div>
                    <div class="country-grid">
                      {
                        list.map((country) => (
                          <a class="country-card" href={`/countries/${country.slug}`} data-region={c.id}>
                            <span class="country-card__flag" aria-hidden="true">{country.flag}</span>
                            <div class="country-card__name" data-ct="name" data-slug={country.slug}>{country.name}</div>
                            <div class="country-card__en">{country.nameEn}</div>
                            <p class="country-card__intro" data-ct="intro" data-slug={country.slug}>{country.intro}</p>
                            <span class="country-card__more" data-i18n="listenRadio">收听电台 →</span>
                          </a>
                        ))
                      }
                    </div>
                  </div>
                );
              })
            }
          </div>
        </section>
      );
    })
  }
</Base>
