---
// 极简首页 —— MORNING WINDOW / 朝の窓辺
//
// 只保留三件事：
//   1. 核心视觉：清晨窗边的一张纸（晨光、毛笔题字、竖排书脊、读数行）
//   2. 大洲巡礼：桌上的一颗地球 + 一份六行的索引
//   3. 页脚（站点简介、关于、统计、声明，由 Footer 组件承担）
//
// 电台列表、播放器、国家卡片全部在 /explore，首页不加载 content-blob，
// 首屏 HTML 保持在几十 KB。
import Base from '../layouts/Base.astro';
import { CONTINENTS, SUBREGIONS } from '../lib/country';
import { allCountries, countriesByContinent } from '../data';
import { GLOBE_POINTS } from '../data/globe-points';
import { graticule, project, CX, CY, R, VIEWBOX, INITIAL_YAW } from '../lib/globe';
import { parseLand, landPaths } from '../lib/land';
import { LAND, ISLES } from '../data/land';
import { t0, DEFAULT_LANG, CONTINENT_LABELS } from '../lib/i18n';
import radiosData from '../data/radios.json';

// 首屏文案用默认语言；切换语言后由 apply-lang 覆盖
const label0 = (id: string) => (CONTINENT_LABELS[DEFAULT_LANG] as Record<string, string>)?.[id];

// 可在线收听的电台总数（与页脚统计口径一致）
const radios = radiosData as Record<string, any[]>;
const totalRadios = allCountries.reduce((sum, c) => {
  const notable = (c.notableRadios || []).filter((r) => r.url).length;
  const fetched = c.radioMode === 'notable-only' ? 0 : (radios[c.iso] || []).length;
  return sum + notable + fetched;
}, 0);

// 地球的首帧在构建期就算好 —— JS 没跑起来时也是一颗完整的地球，只是不转。
const gridPaths = graticule(INITIAL_YAW);
// 海岸线同样在构建期算好首帧
const landD = landPaths(parseLand(LAND), INITIAL_YAW);
// 极小岛国的「岛屿符号」（数据里根本没有的环礁，用一块淡色小圆盘代替）
const isleD = landPaths(parseLand(ISLES), INITIAL_YAW);
const globeDots = GLOBE_POINTS.map((p, i) => {
  const [x, y, z] = project(p[2], p[3], INITIAL_YAW);
  return { i, continent: p[1], x, y, front: z > 0 };
});
const globeData = JSON.stringify(GLOBE_POINTS);
---

<Base>
  {/* 首访过场的第一推动：必须在首帧之前决定「要不要藏内容、要不要变黑」，
      所以只能内联在 head 里，不能等打包的模块。判定一次、记一笔，之后不再走。 */}
  <script slot="head" is:inline>
    (function () {
      try {
        var KEY = 'mr_intro_v1';
        if (window.localStorage.getItem(KEY)) return;
        // 系统里关掉了动效就别演了，直接给正常页面
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.documentElement.classList.add('mr-intro');
        // 记在「开场」而不是「结束」：中途刷新也不该再看第二遍
        window.localStorage.setItem(KEY, '1');
        // 兜底：过场脚本没接上（网络/解析出错）也要把内容放出来，不能扣住。
        // 整段过场约 6.2s，所以兜底放在 8s —— 太早会在动画中途把幕布抽掉。
        setTimeout(function () {
          var el = document.documentElement;
          if (el.classList.contains('mr-intro')) {
            el.classList.remove('mr-intro');
            el.classList.add('mr-intro-out');
            setTimeout(function () {
              el.classList.remove('mr-intro-out');
            }, 1100);
          }
        }, 8000);
      } catch (e) {}
    })();
  </script>

  <section class="hero">
    <div class="container hero__wrap">
      {/* 竖排书脊：只在宽屏出现，给左边缘一条可以「读」的线 */}
      <div class="hero__side" aria-hidden="true">
        <span class="hero__side-text">World Music Radio</span>
        <span class="hero__side-rule"></span>
        <span class="hero__side-num">FM 88–108</span>
      </div>

      <div class="hero__body">
        <div class="wave" aria-hidden="true">
          <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="hero__eyebrow" data-i18n="sloganAttr">{t0.sloganAttr}</div>
        <h1 class="hero__title" data-i18n="slogan">{t0.slogan}</h1>
        <div class="hero__subtitle" data-i18n="subtitle">{t0.subtitle}</div>
        <p class="hero__desc" data-i18n="heroDesc">
          {t0.heroDesc}
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="#continents" data-i18n="start">{t0.start}</a>
          <a class="btn btn--ghost" href="/message-board" data-i18n="guestbookBtn">{t0.guestbookBtn}</a>
        </div>

        {/* 读数行：像书的版权页一样，把整站的规模一行报清 */}
        <div class="hero__readout">
          <span><b>{allCountries.length}</b> <span data-i18n="regionUnit">{t0.regionUnit}</span></span>
          <i aria-hidden="true"></i>
          <span><b>{totalRadios}</b> <span data-i18n="favCountUnit">{t0.favCountUnit}</span></span>
          <i aria-hidden="true"></i>
          <span>FM 88.0 – 108.0</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section home-continents" id="continents">
    <div class="container">
      <div class="section__head" data-reveal>
        <div>
          <div class="section__kicker" data-i18n="exploreKicker">{t0.exploreKicker}</div>
          <h2 class="section__title" data-i18n="exploreTitle">{t0.exploreTitle}</h2>
        </div>
        <p class="home-continents__meta">
          <b>{allCountries.length}</b> <span data-i18n="regionUnit">{t0.regionUnit}</span>
          <i aria-hidden="true"></i>
          <b>{totalRadios}</b> <span data-i18n="favCountUnit">{t0.favCountUnit}</span>
        </p>
      </div>

      {/* 桌上的地球。
          以前这里是六根柱子（柱高＝国家数）—— 但「高低」天然会被读成「主次」，
          于是国家最多的非洲看起来像整站的中心。地球不排座次：每个国家都是球面上
          一样大的一个点，转动它、指到它、点进去。规模只写在右边的索引里。 */}
      <div class="atlas" data-globe data-reveal>
        <div class="atlas__globe">
          <svg class="globe" viewBox={`0 0 ${VIEWBOX} ${VIEWBOX}`} aria-hidden="true" focusable="false">
            <defs>
              <radialGradient id="globe-sheen" cx="36%" cy="28%" r="82%">
                <stop offset="0%" stop-color="#fffdf8" stop-opacity="0.72"></stop>
                <stop offset="46%" stop-color="#fffdf8" stop-opacity="0.26"></stop>
                <stop offset="100%" stop-color="#fffdf8" stop-opacity="0"></stop>
              </radialGradient>
            </defs>
            <circle class="globe__sea" cx={CX} cy={CY} r={R}></circle>
            <circle class="globe__sheen" cx={CX} cy={CY} r={R}></circle>
            <g class="globe__grid">
              {gridPaths.map((d) => <path d={d}></path>)}
            </g>
            {/* 海岸线：细过经纬网一点点，压在点下面 —— 点才是主角 */}
            <g class="globe__land">
              {landD.map((d) => <path d={d}></path>)}
            </g>
            {/* 岛国符号：数据里连一块多边形都没有的环礁，画成一小块淡色陆地，
                否则它的点就真的是「浮在空海上」 */}
            <g class="globe__isles">
              {isleD.map((d) => <path d={d}></path>)}
            </g>
            <g class="globe__dots">
              {
                CONTINENTS.map((c) => (
                  <g data-region={c.id}>
                    {globeDots
                      .filter((d) => d.continent === c.id)
                      .map((d) => (
                        <circle
                          class:list={['globe__dot', !d.front && 'is-back']}
                          data-i={d.i}
                          cx={d.x.toFixed(1)}
                          cy={d.y.toFixed(1)}
                          r={d.front ? '3.1' : '2.2'}
                        />
                      ))}
                  </g>
                ))
              }
            </g>
            <circle class="globe__limb" cx={CX} cy={CY} r={R}></circle>
          </svg>

          {/* 这里平时是空的：只有指针停在某个国家的点上才报名字。
              高度是固定的，所以文字出现/消失不会把下面的索引顶动。 */}
          <p class="atlas__readout">
            <span class="atlas__readout-text"></span>
          </p>
        </div>

        <ol class="atlas__index">
          {
            CONTINENTS.map((c, i) => {
              const n = countriesByContinent(c.id).length;
              const subs = SUBREGIONS.filter((s) => s.continent === c.id);
              return (
                <li>
                  <a class="atlas__row" href={`/explore?c=${c.id}#${c.id}`} data-region={c.id}>
                    <span class="atlas__mark" aria-hidden="true" />
                    <span class="atlas__num" aria-hidden="true">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <span class="atlas__body">
                      <span class="atlas__name" data-continent={c.id}>
                        {label0(c.id) || c.label}
                      </span>
                      <span class="atlas__sub">
                        {subs.length}{' '}
                        <span data-i18n="subdivisionUnit" data-n={subs.length}>
                          {subs.length === 1 && t0.subdivisionUnitOne
                            ? t0.subdivisionUnitOne
                            : t0.subdivisionUnit}
                        </span>
                      </span>
                    </span>
                    <span class="atlas__count">
                      <b>{n}</b> <span data-i18n="regionUnit">{t0.regionUnit}</span>
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ol>
      </div>

      <script type="application/json" id="globe-data" set:html={globeData}></script>
      <script type="application/json" id="land-data" set:html={JSON.stringify(LAND)}></script>
      <script type="application/json" id="isles-data" set:html={JSON.stringify(ISLES)}></script>
    </div>
  </section>
</Base>

<script>
  // 顺序有意义：过场要在 globe 第一次重绘之前把 SVG 克隆走，
  // 这样克隆和真身都是 INITIAL_YAW，交接时不会跳。
  import '../scripts/intro';
  import '../scripts/globe';
</script>
