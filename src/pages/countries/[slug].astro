---
import Base from '../../layouts/Base.astro';
import RadioPlayer from '../../components/RadioPlayer.tsx';
import type { Station } from '../../components/RadioPlayer.tsx';
import { allCountries } from '../../data';
import { REGION_MAP } from '../../lib/country';
import type { Country } from '../../lib/country';
import radiosData from '../../data/radios.json';

export function getStaticPaths() {
  return allCountries.map((c) => ({ params: { slug: c.slug }, props: { country: c } }));
}

const { country } = Astro.props as { country: Country };
const region = REGION_MAP[country.region];
const radios = radiosData as Record<string, any[]>;

const fetchedStations: Station[] = (radios[country.iso] || []).map((s, i) => ({
  id: `${country.iso}-${i}`,
  name: s.name,
  url: s.url,
  hls: !!s.hls,
  codec: s.codec,
  bitrate: s.bitrate,
  tags: s.tags,
}));

const notablePlayable: Station[] = (country.notableRadios || [])
  .filter((r) => r.url)
  .map((r, i) => ({
    id: `notable-${i}`,
    name: r.name,
    url: r.url as string,
    hls: !!r.hls,
    codec: r.hls ? 'HLS' : 'MP3',
    tags: r.genre,
  }));

const notableDescriptive = (country.notableRadios || []).filter((r) => !r.url);

const playable = country.radioMode === 'notable-only' ? notablePlayable : [...notablePlayable, ...fetchedStations];
---

<Base title={`${country.name} · ${country.nameEn}`} description={country.intro}>
  <article data-region={country.region}>
    <header class="country-hero">
      <div class="container container--narrow">
        <nav class="breadcrumb" aria-label="面包屑">
          <a href="/">首页</a><span class="sep">/</span>
          <a href={`/#${country.region}`}>{region.label}</a><span class="sep">/</span>
          <span>{country.name}</span>
        </nav>
        <div class="country-hero__flag" aria-hidden="true">{country.flag}</div>
        <h1 class="country-hero__title">{country.name}</h1>
        <div class="country-hero__en">{country.nameEn}{country.nameLocal ? ` · ${country.nameLocal}` : ''}</div>
        <div class="country-hero__meta">
          <span class="chip">📍 首都 {country.capital}</span>
          <span class="chip">🗣️ {country.languages.join(' / ')}</span>
          {country.isGroup
            ? <span class="chip">🌍 {country.groupCountries?.join('、')}</span>
            : <span class="chip">{region.label}</span>}
        </div>
        <p class="country-hero__intro" style="max-width: 62ch; margin-top: 1.4rem; font-size: 1.05rem; color: var(--ink-soft);">
          {country.intro}
        </p>
      </div>
    </header>

    <div class="container container--narrow" style="padding-top: 2.5rem;">
      <div class="prose">
        <h2><span class="num">I.</span>历史人文</h2>
        {country.history.map((p) => <p set:html={p} />)}

        <h2><span class="num">II.</span>音乐史</h2>
        {country.music.map((p) => <p set:html={p} />)}
      </div>

      <h2 class="section__title" style="margin-top: 2.4rem; font-size: 1.7rem;">音乐家及主要作品</h2>
      <div class="musician-list">
        {country.musicians.map((m) => (
          <div class="musician">
            <div class="musician__name">{m.name}</div>
            {m.nameEn && <div class="musician__en">{m.nameEn}</div>}
            <div class="musician__role">{m.role}</div>
            <div class="musician__desc">{m.desc}</div>
          </div>
        ))}
      </div>

      <h2 class="section__title" style="margin-top: 2.8rem; font-size: 1.7rem;">主要音乐电台</h2>

      {notableDescriptive.length > 0 && (
        <div class="radio-grid" style="margin-bottom: 0.6rem;">
          {notableDescriptive.map((r) => (
            <div class="radio-card" style="cursor: default;">
              <div class="radio-card__play" aria-hidden="true" style="background: var(--surface-deep); color: var(--ink-faint); border-color: var(--line);">♪</div>
              <div class="radio-card__body">
                <div class="radio-card__name">{r.name}</div>
                <div class="radio-card__meta">
                  <span class="radio-tag">{r.genre}</span>
                </div>
                {r.note && <div style="font-size: 0.82rem; color: var(--ink-faint); line-height: 1.6; margin-top: 0.4rem;">{r.note}</div>}
              </div>
            </div>
          ))}
        </div>
      )}

      <RadioPlayer client:load stations={playable} countryName={country.name} flag={country.flag} />
    </div>
  </article>
</Base>
